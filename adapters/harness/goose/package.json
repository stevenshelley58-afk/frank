{
  "name": "@frank/adapter-harness-goose",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Goose harness adapter for FRANK rooms. Implements the HarnessAdapter protocol against Goose's ACP HTTP/WebSocket server.",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "echo 'lint: adapter-harness-goose'"
  },
  "dependencies": {
    "@frank/contracts": "workspace:*",
    "ws": "8.18.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/ws": "8.18.0",
    "typescript": "5.7.2",
    "vitest": "2.1.8"
  },
  "frank": {
    "layer": "adapter",
    "mayDependOn": ["@frank/contracts"]
  }
}
