# Copy to /opt/frank-hub/runtime/access/frank-access.env on the VPS.
# Do not commit the real file.

FRANK_EMAIL_ADDRESS=frank@example.com
FRANK_MOBILE_NUMBER=+15550000000
FRANK_WHATSAPP_NUMBER=+15550000000

# Names are dashboard-visible. Values below are secrets and stay only on the VPS.
FRANK_API_KEY_NAMES=OPENAI_API_KEY,OPENROUTER_API_KEY,FRANK_EMAIL_APP_PASSWORD,FRANK_WHATSAPP_API_TOKEN

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_CHAT_MODEL=gpt-5.2
OPENROUTER_API_KEY=
FRANK_EMAIL_APP_PASSWORD=
FRANK_WHATSAPP_API_TOKEN=

# Host-agent and browser secrets. Generate a long random token on the VPS.
FRANK_HOST_AGENT_TOKEN=change-this-host-agent-token
FRANK_BROWSER_VNC_PASSWORD=

# Hermes-native WhatsApp lab runtime.
WHATSAPP_ENABLED=true
WHATSAPP_MODE=bot
# WhatsApp numbers for Hermes allowlists use country code with no leading +.
WHATSAPP_ALLOWED_USERS=15550000000
WEBHOOK_ENABLED=true
WEBHOOK_SECRET=change-this-hermes-webhook-secret
HERMES_WEBHOOK_SECRET=change-this-hermes-webhook-secret
