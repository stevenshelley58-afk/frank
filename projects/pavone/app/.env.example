# Copy to .env and fill in. .env is gitignored AND dockerignored — the key must
# never reach a git commit or an image layer. On the Frank VPS this should be
# sourced from OpenBao rather than kept as a file long-term.

# Port the Node server listens on. Caddy reverse-proxies to this.
PORT=8787

# Google Gemini API key used for the image edits (server-side only).
GEMINI_API_KEY=

# Image-editing model. gemini-3.1-flash-image (~$0.067/render at 1K) is the
# cheapest one that ACTUALLY edits the glass. gemini-2.5-flash-image was measured
# regenerating the whole scene instead — a ~3-point luminance gap between 70% and
# 5%, i.e. no visible product. Do not "save money" by switching back without
# re-running tools/render-harness.mjs first.
GEMINI_MODEL=gemini-3.1-flash-image

# Password for the HTTP Basic-auth /admin leads page. Any username works.
ADMIN_PASSWORD=

# Where renders and leads are written. Defaults to <app>/data.
# In Docker this is set to /app/data by the Dockerfile and backed by a volume.
DATA_DIR=/app/data

# Free renders per visitor IP per UTC day before the contact gate.
# Only SUCCESSFUL renders consume quota.
RENDER_LIMIT_PER_DAY=3
