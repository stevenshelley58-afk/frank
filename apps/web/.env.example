# Frank web — env example. Copy to .env.local and fill in.

# FRANK Domain API base URL (server-side only) — WB-05. Delegations are
# handed to POST /v1/workbenches here; the browser reaches the same API
# same-origin via the reverse proxy. Defaults to http://127.0.0.1:8080.
FRANK_DOMAIN_API_URL=http://127.0.0.1:8080

# Harness identity guard (Phase 5): the model Steve expects Frank to run on.
# If a harness reports something else, the UI shows a mismatch warning.
# Basename comparison ('deepseek-chat' == 'deepseek/deepseek-chat').
FRANK_EXPECTED_MODEL=deepseek-chat
