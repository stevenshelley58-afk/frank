{
  "schema": "schema://frank.tool-app-manifest/v1",
  "id": "ad-template-generator",
  "name": "Ad Studio",
  "description": "Build portable, editable and source-safe ad TemplatePacks with durable scored generation evidence.",
  "release_schema": "schema://frank.template-pack/v1",
  "version": "2.1.0",
  "kind": "tool",
  "scopes": ["project", "workspace"],
  "settings": {
    "schema": "schema://frank.tool-app-settings/v1",
    "properties": {
      "model_policy_revision": {"type": "integer", "minimum": 1},
      "placements": {"type": "array", "items": {"enum": ["square", "portrait", "story"]}},
      "qa_thresholds": {"type": "object"},
      "approval_policy": {"type": "string", "const": "studio_qa_100_percent"},
      "connection": {"type": "object", "properties": {"connection_id": {"type": "string"}, "capability": {"type": "string"}}}
    }
  },
  "pipelines": [
    {
      "id": "template-pack-v2",
      "version": "2.1.0",
      "schema": "schema://frank.tool-app-pipeline/v1",
      "nodes": [
        {"id": "source", "kind": "source"},
        {"id": "analyse", "kind": "ai-vision"},
        {"id": "decompose", "kind": "deterministic"},
        {"id": "restyle", "kind": "deterministic"},
        {"id": "story-draft", "kind": "deterministic"},
        {"id": "render", "kind": "deterministic"},
        {"id": "visual-review", "kind": "iterative-gate"},
        {"id": "check", "kind": "deterministic"},
        {"id": "subject-invariance", "kind": "deterministic"},
        {"id": "studio-qa", "kind": "approval"},
        {"id": "ready", "kind": "gate"},
        {"id": "release", "kind": "release"}
      ],
      "edges": [
        {"from": "source", "to": "analyse"},
        {"from": "analyse", "to": "decompose"},
        {"from": "decompose", "to": "restyle"},
        {"from": "restyle", "to": "story-draft"},
        {"from": "story-draft", "to": "render"},
        {"from": "render", "to": "visual-review"},
        {"from": "visual-review", "to": "check"},
        {"from": "check", "to": "subject-invariance"},
        {"from": "subject-invariance", "to": "studio-qa"},
        {"from": "studio-qa", "to": "ready"},
        {"from": "ready", "to": "release"}
      ]
    }
  ],
  "capabilities": ["source.ingest", "template.analyse", "template.decompose", "template.restyle", "template.render", "template.score", "template.revise", "qa.review", "template-pack.issue"],
  "connectors": ["image.masked-edit", "vision.structured"],
  "schedules": [],
  "thresholds": [
    {"id": "source-identity", "key": "source_identity_leakage", "value": 0, "minimum": 0, "maximum": 0},
    {"id": "primary-likeness", "key": "primary_ad_system_likeness", "value": 9.5, "minimum": 9.5, "maximum": 10},
    {"id": "strict-likeness", "key": "strict_ad_system_likeness", "value": 9.5, "minimum": 9.5, "maximum": 10},
    {"id": "subject-invariance", "key": "subject_invariance_pass", "value": 1, "minimum": 1, "maximum": 1},
    {"id": "residual", "key": "residual_score", "value": 0.02, "minimum": 0, "maximum": 0.02}
  ],
  "approval_gates": ["studio-qa"],
  "hermes": {
    "actions": ["build-template", "approve", "retry", "cancel", "change-remaining-models"],
    "event_kinds": ["command-accepted", "stage-started", "generation-started", "generation-rendered", "generation-scored", "generation-revision-requested", "generation-accepted", "artifact-recorded", "qa-gate", "tool-started", "tool-completed", "approval-requested", "approval-approved", "model-policy-changed", "release-published", "run-failed"]
  },
  "trace": {
    "schema": "schema://frank.tool-app-trace/v1",
    "style": "otel-genai",
    "event_kinds": ["command-accepted", "stage-started", "generation-started", "generation-rendered", "generation-scored", "generation-revision-requested", "generation-accepted", "artifact-recorded", "qa-gate", "tool-started", "tool-completed", "approval-requested", "approval-approved", "model-policy-changed", "release-published", "run-failed"]
  },
  "metadata": {
    "lineage": {"engine_owner": "hermes", "runtime": "durable-tool-run"},
    "health": {"endpoint": "hermes://ad-template-generator/health", "states": ["ready", "degraded", "blocked", "unavailable"]},
    "pack_contract": "schema://frank.template-pack/v1"
  }
}
