{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"schema://frank.template-pack/v1",
  "title":"Portable Ad TemplatePack",
  "type":"object",
  "required":["schema","pack_version","id","compatibility","document","layouts","assets","fields","ad","editor","previews","provenance","qa","approval","integrity"],
  "properties":{
    "schema":{"const":"schema://frank.template-pack/v1"},"pack_version":{"const":"1.0.0"},"id":{"type":"string","pattern":"^[A-Za-z0-9][A-Za-z0-9._:-]+$"},
    "compatibility":{"type":"array","minItems":1,"items":{"type":"string"}},"document":{"type":"object"},
    "layouts":{"type":"object","required":["feed","story"],"additionalProperties":{"type":"object"}},"assets":{"type":"array"},
    "fields":{"type":"object","required":["images","text","baked"],"properties":{"images":{"type":"array"},"text":{"type":"array"},"baked":{"type":"array"}}},
    "ad":{"type":"object","required":["copy","cta","destination","lead_form","meta"]},"editor":{"type":"object"},"previews":{"type":"array"},
    "provenance":{"type":"object","required":["hashes","model_policy_revision","release_trace_ref","sanitization_receipt"]},
    "qa":{"type":"object","required":["all_gates_passed","subject_invariance_passed","source_identity_leakage"]},
    "approval":{"type":"object","required":["confirmed_100_percent","decision"]},
    "integrity":{"type":"object","required":["checksum","signature"]}
  },"additionalProperties":false
}
