{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schema://frank.ad-template-generator-release/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "tool_id", "scope", "release_version", "release_id", "status", "settings_revision", "settings_ref", "pipeline_id", "pipeline_version", "consumer_compatibility", "template_pack", "provenance", "trace_ref", "qa_receipt", "approval_receipt", "sanitization_receipt", "released_at", "release_hash", "immutable", "source_free"],
  "properties": {
    "schema": {"const": "schema://frank.ad-template-generator-release/v1"},
    "tool_id": {"const": "ad-template-generator"},
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id"],
      "properties": {"kind": {"enum": ["project", "workspace"]}, "id": {"type": "string", "minLength": 1}}
    },
    "release_version": {"const": "1.0.0"},
    "release_id": {"type": "string", "minLength": 1},
    "status": {"const": "released"},
    "settings_revision": {"type": "integer", "minimum": 0},
    "settings_ref": {"type": "string", "minLength": 1},
    "pipeline_id": {"const": "reference-clone-release"},
    "pipeline_version": {"const": "1.0.0"},
    "consumer_compatibility": {"const": ["blockwise-template-pack-v1"]},
    "template_pack": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "pack_id", "artifact_ref", "sha256", "signature_algorithm", "signature"],
      "properties": {
        "schema": {"const": "blockwise.template-pack/v1"},
        "pack_id": {"type": "string", "minLength": 1},
        "artifact_ref": {"type": "string", "pattern": "^https://"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "signature_algorithm": {"const": "ed25519"},
        "signature": {"type": "string", "minLength": 16, "maxLength": 512}
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_ref", "artifact_receipt_ref"],
      "properties": {"artifact_ref": {"type": "string", "pattern": "^https://"}, "artifact_receipt_ref": {"type": "string", "minLength": 1}}
    },
    "trace_ref": {"type": "string", "minLength": 1},
    "qa_receipt": {"$ref": "#/$defs/qaReceipt"},
    "approval_receipt": {"$ref": "#/$defs/approvalReceipt"},
    "sanitization_receipt": {"$ref": "#/$defs/sanitizationReceipt"},
    "released_at": {"type": "string", "format": "date-time"},
    "release_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "immutable": {"const": true},
    "source_free": {"const": true}
  },
  "$defs": {
    "qaReceipt": {
      "type": "object", "additionalProperties": false,
      "required": ["decision", "receipt_ref", "checked_at"],
      "properties": {"decision": {"const": "pass"}, "receipt_ref": {"type": "string", "minLength": 1}, "checked_at": {"type": "string", "format": "date-time"}}
    },
    "approvalReceipt": {
      "type": "object", "additionalProperties": false,
      "required": ["decision", "gate", "receipt_ref", "decided_at"],
      "properties": {"decision": {"const": "approved"}, "gate": {"const": "native-pixel-human-approval"}, "receipt_ref": {"type": "string", "minLength": 1}, "decided_at": {"type": "string", "format": "date-time"}}
    },
    "sanitizationReceipt": {
      "type": "object", "additionalProperties": false,
      "required": ["decision", "receipt_ref", "checked_at"],
      "properties": {"decision": {"const": "pass"}, "receipt_ref": {"type": "string", "minLength": 1}, "checked_at": {"type": "string", "format": "date-time"}}
    }
  }
}
