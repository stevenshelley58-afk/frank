{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schema://frank.content-factory-release/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "tool_id", "project_id", "workspace_id", "settings_revision", "pipeline_id", "pipeline_version", "consumer_compatibility", "release_id", "content_id", "version", "immutable", "status", "channel", "title", "body", "media", "seo", "qa_receipt", "approval_receipt", "provenance", "sanitization_receipts", "published_at", "release_hash"],
  "properties": {
    "schema": {"const": "schema://frank.content-factory-release/v1"},
    "tool_id": {"const": "content-factory"},
    "project_id": {"type": "string", "minLength": 1},
    "workspace_id": {"type": "string", "minLength": 1},
    "settings_revision": {"type": "integer", "minimum": 0},
    "pipeline_id": {"const": "content-factory-pipeline"},
    "pipeline_version": {"const": "1.0.0"},
    "consumer_compatibility": {"type": "array", "minItems": 1, "uniqueItems": true, "contains": {"const": "article-release-v1"}},
    "release_id": {"type": "string", "minLength": 1},
    "content_id": {"type": "string", "minLength": 1},
    "version": {"type": "integer", "minimum": 1},
    "immutable": {"const": true},
    "status": {"const": "published"},
    "channel": {"enum": ["web", "email", "social", "ads", "instant-forms"]},
    "title": {"type": "string", "minLength": 1},
    "summary": {"type": "string", "minLength": 1},
    "body": {"type": "object", "additionalProperties": false, "required": ["format", "content"], "properties": {"format": {"const": "markdown"}, "content": {"type": "string", "minLength": 1}}},
    "media": {"type": "array", "items": {"$ref": "#/$defs/media"}},
    "seo": {"type": "object", "additionalProperties": false, "required": ["title", "description", "canonical_url"], "properties": {"title": {"type": "string", "minLength": 1}, "description": {"type": "string", "minLength": 1}, "canonical_url": {"type": "string", "format": "uri"}}},
    "qa_receipt": {"$ref": "#/$defs/qaReceipt"},
    "approval_receipt": {"$ref": "#/$defs/approvalReceipt"},
    "provenance": {"type": "object", "additionalProperties": false, "required": ["trace_id", "artifact_checksums"], "properties": {"trace_id": {"type": "string", "minLength": 1}, "artifact_checksums": {"type": "object", "minProperties": 2, "additionalProperties": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}}},
    "sanitization_receipts": {"type": "object", "additionalProperties": false, "required": ["pii_scan", "secret_scan"], "properties": {"pii_scan": {"$ref": "#/$defs/scanReceipt"}, "secret_scan": {"$ref": "#/$defs/scanReceipt"}}},
    "published_at": {"type": "string", "format": "date-time"},
    "release_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "$defs": {
    "media": {"type": "object", "additionalProperties": false, "required": ["id", "url", "alt_text", "checksum"], "properties": {"id": {"type": "string", "minLength": 1}, "url": {"type": "string", "format": "uri"}, "alt_text": {"type": "string", "minLength": 1}, "checksum": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}},
    "qaReceipt": {"type": "object", "additionalProperties": false, "required": ["decision", "receipt_ref", "checked_at"], "properties": {"decision": {"const": "pass"}, "receipt_ref": {"type": "string", "minLength": 1}, "checked_at": {"type": "string", "format": "date-time"}}},
    "approvalReceipt": {"type": "object", "additionalProperties": false, "required": ["decision", "receipt_ref", "decided_at"], "properties": {"decision": {"const": "approve"}, "receipt_ref": {"type": "string", "minLength": 1}, "decided_at": {"type": "string", "format": "date-time"}}},
    "scanReceipt": {"type": "object", "additionalProperties": false, "required": ["status", "receipt_id", "scanned_at"], "properties": {"status": {"const": "passed"}, "receipt_id": {"type": "string", "minLength": 1}, "scanned_at": {"type": "string", "format": "date-time"}}}
  }
}
