{
  "schema": "schema://frank.tool-app-manifest/v1",
  "id": "content-factory",
  "version": "1.1.0",
  "name": "Content Factory",
  "description": "Hermes-owned contracts for research-to-release content work.",
  "release_schema": "schema://frank.content-factory-release/v1",
  "scopes": ["project", "workspace", "session"],
  "settings": {
    "schema": "schema://frank.tool-app-settings/v1",
    "properties": {
      "prompt_refs": {"type": "object", "description": "Versioned Hermes prompt references per stage."},
      "tone_style": {"type": "object"},
      "channels": {"type": "array", "items": {"enum": ["web", "email", "social", "ads", "instant-forms"]}},
      "model_policy": {"type": "object"},
      "thresholds": {"type": "object"},
      "approvals": {"type": "object"},
      "schedule_ref": {"type": "string"},
      "publication_targets": {"type": "array", "description": "Connections-managed target IDs only."}
    }
  },
  "pipelines": [{
    "id": "content-factory-pipeline",
    "version": "1.0.0",
    "schema": "schema://frank.tool-app-pipeline/v1",
    "nodes": [
      {"id": "source", "kind": "source"}, {"id": "research", "kind": "stage"}, {"id": "brief", "kind": "stage"}, {"id": "draft", "kind": "stage"}, {"id": "edit", "kind": "stage"}, {"id": "format", "kind": "stage"}, {"id": "seo", "kind": "stage"}, {"id": "media", "kind": "stage"}, {"id": "web", "kind": "channel"}, {"id": "email", "kind": "channel"}, {"id": "social", "kind": "channel"}, {"id": "ads", "kind": "channel"}, {"id": "instant-forms", "kind": "channel"}, {"id": "compliance", "kind": "gate"}, {"id": "human-approval", "kind": "gate"}, {"id": "immutable-release", "kind": "gate"}
    ],
    "edges": [
      {"from": "source", "to": "research"}, {"from": "research", "to": "brief"}, {"from": "brief", "to": "draft"}, {"from": "draft", "to": "edit"}, {"from": "edit", "to": "format"}, {"from": "edit", "to": "seo"}, {"from": "edit", "to": "media"}, {"from": "format", "to": "web"}, {"from": "format", "to": "email"}, {"from": "format", "to": "social"}, {"from": "format", "to": "ads"}, {"from": "format", "to": "instant-forms"}, {"from": "seo", "to": "web"}, {"from": "media", "to": "web"}, {"from": "media", "to": "social"}, {"from": "media", "to": "ads"}, {"from": "web", "to": "compliance"}, {"from": "email", "to": "compliance"}, {"from": "social", "to": "compliance"}, {"from": "ads", "to": "compliance"}, {"from": "instant-forms", "to": "compliance"}, {"from": "compliance", "to": "human-approval"}, {"from": "human-approval", "to": "immutable-release"}
    ]
  }],
  "capabilities": ["resume", "rerun", "quarantine", "versioning", "withdrawal-tombstones", "otel-trace"],
  "connectors": [{"id": "hermes", "kind": "commands-events"}, {"id": "connections", "kind": "target-ids"}],
  "schedules": [{"id": "hermes-schedule-ref", "owner": "hermes"}],
  "thresholds": [{"id": "word-count"}, {"id": "media"}, {"id": "seo"}, {"id": "compliance"}],
  "approval_gates": [{"id": "human-approval", "required": true}, {"id": "immutable-release", "required": true}],
  "actions": ["run", "resume", "rerun", "withdraw"],
  "events": ["stage-completed", "review-requested", "release-immutable", "quarantined", "withdrawn"],
  "trace": {
    "schema": "schema://frank.tool-app-trace/v1",
    "style": "otel-genai",
    "event_allowlist": ["stage-started", "stage-completed", "review-requested", "release-immutable", "quarantined", "withdrawn"],
    "fields": ["trace_id", "span_id", "stage", "model_ref", "prompt_hash", "cost", "artifact_refs", "evidence_refs", "review_decision"],
    "preserve_hooks": ["trace", "slot-trace", "trace-view"]
  }
}
