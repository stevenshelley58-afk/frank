  "version": "2.0.0",
  "project_id": "blockwise",
  "manifest_ref": "content-factory@2.0.0",
  "process_graph_ref": "blog-studio-v2",
  "request_defaults": {
    "direction": {
      "audience": "Australian real-estate operators",
