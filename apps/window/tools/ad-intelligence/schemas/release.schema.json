{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schema://frank.ad-intelligence-release/v1",
  "title": "Frank Ad Intelligence Release v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "tool_id",
    "pipeline_id",
    "pipeline_version",
    "consumer_compatibility",
    "release_id",
    "version",
    "status",
    "released_at",
    "immutable",
    "project_scope",
    "checksum",
    "provenance_refs",
    "trace_refs",
    "settings_revision",
    "settings_ref",
    "qa_receipt",
    "sanitization_receipts",
    "release_hash",
    "public_export"
  ],
  "properties": {
    "schema": {"const": "schema://frank.ad-intelligence-release/v1"},
    "tool_id": {"const": "ad-intelligence"},
    "pipeline_id": {"const": "ad-radar-pipeline"},
    "pipeline_version": {"const": "1.0.0"},
    "consumer_compatibility": {
      "type": "array",
      "prefixItems": [{"const": "ad-intelligence-public-v1"}],
      "items": false,
      "minItems": 1,
      "maxItems": 1
    },
    "release_id": {"type": "string", "minLength": 1},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "status": {"const": "released"},
    "released_at": {"type": "string", "format": "date-time"},
    "immutable": {"const": true},
    "project_scope": {"type": "string", "minLength": 1},
    "checksum": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "provenance_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "trace_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "settings_revision": {"type": "integer", "minimum": 1},
    "settings_ref": {"type": "string", "minLength": 1},
    "qa_receipt": {"$ref": "#/$defs/qaReceipt"},
    "sanitization_receipts": {"$ref": "#/$defs/sanitizationReceipts"},
    "release_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "public_export": {"$ref": "schema://frank.ad-intelligence-public/v1"}
  },
  "$defs": {
    "qaReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decision", "receipt_ref", "checked_at"],
      "properties": {
        "decision": {"const": "pass"},
        "receipt_ref": {"type": "string", "minLength": 1},
        "checked_at": {"type": "string", "format": "date-time"}
      }
    },
    "scanReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "receipt_id", "scanned_at"],
      "properties": {
        "status": {"const": "passed"},
        "receipt_id": {"type": "string", "minLength": 1},
        "scanned_at": {"type": "string", "format": "date-time"}
      }
    },
    "sanitizationReceipts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pii_scan", "secret_scan"],
      "properties": {
        "pii_scan": {"$ref": "#/$defs/scanReceipt"},
        "secret_scan": {"$ref": "#/$defs/scanReceipt"}
      }
    }
  },
  "x-integrity": {
    "canonicalization": "RFC8785",
    "public_export_checksum_field": "checksum",
    "release_hash_excludes": ["release_hash"]
  }
}
