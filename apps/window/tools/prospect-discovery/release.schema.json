{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schema://frank.prospect-discovery-release/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "tool_id", "pipeline_id", "pipeline_version", "consumer_compatibility", "release_id", "version", "status", "released_at", "immutable", "project_scope", "settings_revision", "settings_ref", "trace_refs", "sanitization_receipt_refs", "verification_receipt_refs", "candidates", "release_hash"],
  "properties": {
    "schema": {"const": "schema://frank.prospect-discovery-release/v1"},
    "tool_id": {"const": "prospect-discovery"},
    "pipeline_id": {"const": "discover-enrich-qualify"},
    "pipeline_version": {"const": "1.0.0"},
    "consumer_compatibility": {"const": ["prospect-release-v1"]},
    "release_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"},
    "version": {"type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$"},
    "status": {"const": "released"},
    "released_at": {"type": "string", "format": "date-time"},
    "immutable": {"const": true},
    "project_scope": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"},
    "settings_revision": {"type": "integer", "minimum": 1},
    "settings_ref": {"$ref": "#/$defs/settingsRef"},
    "trace_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/traceRef"}},
    "sanitization_receipt_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/receiptRef"}},
    "verification_receipt_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/receiptRef"}},
    "candidates": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/candidate"}},
    "release_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "$defs": {
    "opaqueRefGuard": {
      "type": "string",
      "not": {
        "anyOf": [
          {"pattern": "[0-9](?:[/._-]?[0-9]){7,}"},
          {"pattern": "(?:[Aa][Pp][Ii][_-]?[Kk][Ee][Yy][_-]|[Gg][Hh][PpOoUuSsRr]_|[Gg][Ii][Tt][Hh][Uu][Bb]_[Pp][Aa][Tt]_|[Xx][Oo][Xx][BbAaPpRrSs]-)"},
          {"pattern": "(?:[Ss][Kk]|[Pp][Kk]|[Rr][Kk])_(?:[Ll][Ii][Vv][Ee]|[Tt][Ee][Ss][Tt])_[A-Za-z0-9]+"},
          {"pattern": "[Jj][Aa][Vv][Aa][Ss][Cc][Rr][Ii][Pp][Tt]:"},
          {"pattern": "-----[Bb][Ee][Gg][Ii][Nn][A-Za-z -]+-----"}
        ]
      }
    },
    "prospectRef": {"allOf": [{"$ref": "#/$defs/opaqueRefGuard"}, {"pattern": "^prospect://[A-Za-z0-9][A-Za-z0-9._:/-]{0,255}$"}]},
    "contactRef": {"allOf": [{"$ref": "#/$defs/opaqueRefGuard"}, {"pattern": "^contact://[A-Za-z0-9][A-Za-z0-9._:/-]{0,255}$"}]},
    "evidenceRef": {"allOf": [{"$ref": "#/$defs/opaqueRefGuard"}, {"pattern": "^evidence://[A-Za-z0-9][A-Za-z0-9._:/-]{0,255}$"}]},
    "policyRef": {"allOf": [{"$ref": "#/$defs/opaqueRefGuard"}, {"pattern": "^policy://[A-Za-z0-9][A-Za-z0-9._:/-]{0,255}$"}]},
    "receiptRef": {"allOf": [{"$ref": "#/$defs/opaqueRefGuard"}, {"pattern": "^receipt://[A-Za-z0-9][A-Za-z0-9._:/-]{0,255}$"}]},
    "settingsRef": {"allOf": [{"$ref": "#/$defs/opaqueRefGuard"}, {"pattern": "^settings://[A-Za-z0-9][A-Za-z0-9._:/-]{0,255}$"}]},
    "traceRef": {"allOf": [{"$ref": "#/$defs/opaqueRefGuard"}, {"pattern": "^trace://[A-Za-z0-9][A-Za-z0-9._:/-]{0,255}$"}]},
    "qualification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decision", "score", "policy_ref"],
      "properties": {"decision": {"const": "qualified"}, "score": {"type": "number", "minimum": 0, "maximum": 1}, "policy_ref": {"$ref": "#/$defs/policyRef"}}
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["prospect_ref", "contact_ref", "evidence_refs", "qualification", "verification_receipt_ref"],
      "properties": {
        "prospect_ref": {"$ref": "#/$defs/prospectRef"},
        "contact_ref": {"$ref": "#/$defs/contactRef"},
        "evidence_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/evidenceRef"}},
        "qualification": {"$ref": "#/$defs/qualification"},
        "verification_receipt_ref": {"$ref": "#/$defs/receiptRef"}
      }
    }
  }
}
