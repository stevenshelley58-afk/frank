{
  "schema": "schema://frank.tool-app-manifest/v1",
  "id": "mail",
  "version": "0.1.1",
  "name": "Mail",
  "description": "Provider-neutral thread, message, cursor, delivery, reply, bounce, complaint, and unsubscribe projections.",
  "scopes": ["profile", "project", "workspace", "session"],
  "settings": {"schema": "schema://frank.tool-app-settings/v1", "properties": {"connection": {"type": "object", "properties": {"connection_id": {"type": "string"}, "capability": {"type": "string"}}}, "sync": {"type": "object", "properties": {"cursor_strategy": {"type": "string"}, "page_size": {"type": "integer"}, "poll_interval": {"type": "string"}}}, "reply_classification": {"type": "object", "properties": {"labels": {"type": "array"}, "model_capability": {"type": "string"}, "model_policy": {"type": "string"}, "confidence_threshold": {"type": "number"}}}}},
  "pipelines": [{"schema": "schema://frank.tool-app-pipeline/v1", "id": "sync-and-project", "nodes": [{"id": "sync", "kind": "sync"}, {"id": "thread", "kind": "thread-projection"}, {"id": "message", "kind": "message-projection"}, {"id": "receipt", "kind": "delivery-receipt"}, {"id": "classify", "kind": "reply-classification"}, {"id": "events", "kind": "mail-events"}], "edges": [{"from": "sync", "to": "thread"}, {"from": "thread", "to": "message"}, {"from": "message", "to": "receipt"}, {"from": "message", "to": "classify"}, {"from": "receipt", "to": "events"}, {"from": "classify", "to": "events"}]}],
  "capabilities": ["thread-sync", "message-projection", "cursor-management", "delivery-receipts", "reply-classification", "bounce-events", "complaint-events", "unsubscribe-events", "compose-intent", "reply-intent"],
  "connectors": [{"id": "mail-provider", "capabilities": ["mail-read", "mail-receipts", "mail-events"]}],
  "schedules": [{"id": "mail-sync", "mode": "poll", "cursor_aware": true}],
  "thresholds": [{"id": "reply-confidence", "setting": "reply_classification.confidence_threshold", "minimum": 0}],
  "approval_gates": [],
  "data_boundary": {"owns": ["canonical_thread_projections", "canonical_message_projections", "sync_cursors", "delivery_receipts", "reply_events", "bounce_events", "complaint_events", "unsubscribe_events", "reply_classification"], "consumes": ["connection_id", "outreach_send_ledger_ref"], "never_owns": ["provider_raw_message_bodies", "consent_or_legal_basis", "campaign_policy", "global_suppression", "raw_send_transport"], "ad_intelligence": "stable_subject_ref_only", "prospect_records_in_ad_evidence": false, "prospect_records_in_public_exports": false, "pii_policy": "provider_owns_raw_bodies;_mail_keeps_minimized_provider_neutral_projections"},
  "graph": {"schema": "schema://frank.graph/v1", "projection": {"adapter": "ToolManifestAdapter", "renderer": "maxGraph", "prompt_inspector": "CodeMirror 6", "payload_editor": "vanilla-jsoneditor+Ajv"}, "execution": "hermes_only", "settings_revisions": "shared_tool_contract_immutable", "nodes": ["connection_id", "thread", "message", "sync_cursor", "delivery_receipt", "reply_event", "bounce_event", "complaint_event", "unsubscribe_event", "reply_classification", "outreach_send_ledger_ref", "stable_subject_ref"], "edges": ["connection_id->thread", "thread->message", "connection_id->sync_cursor", "message->delivery_receipt", "message->reply_event", "message->bounce_event", "message->complaint_event", "message->unsubscribe_event", "message->reply_classification", "outreach_send_ledger_ref->message", "stable_subject_ref->thread"]},
  "trace": {"schema": "schema://frank.tool-app-trace/v1", "instrumentation": "opentelemetry", "span_prefix": "frank.mail", "attributes": ["mail.thread_id", "mail.message_id", "mail.connection_id", "mail.cursor_kind", "mail.delivery_state", "mail.reply_label"], "events": ["mail.sync.started", "mail.thread.upserted", "mail.message.upserted", "mail.receipt.recorded", "mail.reply.recorded", "mail.bounce.recorded", "mail.complaint.recorded", "mail.unsubscribe.recorded"]},
  "health": {"contract": "tool_health.v1", "checks": ["manifest_valid", "connection_capability_present", "cursor_store_reachable", "receipt_projection_available", "provider_raw_body_boundary_declared"], "states": ["healthy", "degraded", "unavailable"]},
  "widget": {"contract": "tool_widget.v1", "id": "mail", "surfaces": ["tool", "project"], "states": ["idle", "syncing", "stale", "ready", "error"], "read_models": ["thread_summary", "message_summary", "delivery_summary", "reply_summary", "cursor_summary"], "actions": ["sync", "open_thread", "inspect_receipt", "review_classification", "compose_intent", "reply_intent"]},
  "hermes": {"contract": "hermes_tool_boundary.v1", "commands": ["mail.sync", "mail.thread.list", "mail.thread.read", "mail.receipt.read", "mail.reply.classify", "mail.compose.intent", "mail.reply.intent"], "events": ["mail.sync.started", "mail.sync.completed", "mail.thread.updated", "mail.message.updated", "mail.receipt.recorded", "mail.reply.recorded", "mail.bounce.recorded", "mail.complaint.recorded", "mail.unsubscribe.recorded", "mail.reply.classified", "mail.compose.intent.created", "mail.reply.intent.created"], "forbidden_commands": ["mail.raw_send", "mail.provider_send", "outreach.delivery.request", "prospect.qualify"], "result_rule": "provider_neutral_projections_and_intents_only; provider owns raw bodies and delivery execution"}
}
