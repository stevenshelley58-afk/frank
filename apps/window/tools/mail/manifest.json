{
  "schema": "schema://frank.tool-app-manifest/v1",
  "id": "mail",
  "version": "0.1.1",
  "name": "Mail",
  "description": "Provider-neutral thread, message, cursor, delivery, reply, bounce, complaint, and unsubscribe projections.",
  "scopes": ["profile", "project", "workspace", "session"],
  "settings": {"schema": "schema://frank.tool-app-settings/v1", "properties": {"connection": {"type": "object", "properties": {"connection_id": {"type": "string"}, "capability": {"type": "string"}}}, "sync": {"type": "object", "properties": {"cursor_strategy": {"type": "string"}, "page_size": {"type": "integer"}, "poll_interval": {"type": "string"}}}, "reply_classification": {"type": "object", "properties": {"labels": {"type": "array"}, "prompt_ref": {"type": "string"}, "prompt_version": {"type": "string"}, "model_capability": {"type": "string"}, "model_policy": {"type": "string"}, "confidence_threshold": {"type": "number"}}}}},
  "pipelines": [{"schema": "schema://frank.tool-app-pipeline/v1", "id": "sync-and-project", "nodes": [{"id": "sync", "kind": "sync"}, {"id": "thread", "kind": "thread-projection"}, {"id": "message", "kind": "message-projection"}, {"id": "receipt", "kind": "delivery-receipt"}, {"id": "classify", "kind": "reply-classification"}, {"id": "events", "kind": "mail-events"}], "edges": [{"from": "sync", "to": "thread"}, {"from": "thread", "to": "message"}, {"from": "message", "to": "receipt"}, {"from": "message", "to": "classify"}, {"from": "receipt", "to": "events"}, {"from": "classify", "to": "events"}]}],
  "capabilities": ["thread-sync", "message-projection", "cursor-management", "delivery-receipts", "reply-classification", "bounce-events", "complaint-events", "unsubscribe-events", "compose-intent", "reply-intent"],
  "connectors": [{"id": "mail-provider", "capabilities": ["mail-read", "mail-receipts", "mail-events"]}],
  "schedules": [{"id": "mail-sync", "mode": "poll", "cursor_aware": true}],
  "thresholds": [{"id": "reply-confidence", "setting": "reply_classification.confidence_threshold", "minimum": 0}],
  "approval_gates": [],
  "data_boundary": {"owns": ["canonical_thread_projections", "canonical_message_projections", "sync_cursors", "delivery_receipts", "reply_events", "bounce_events", "complaint_events", "unsubscribe_events", "reply_classification"], "consumes": ["connection_id", "connection_action_receipt_refs"], "never_owns": ["provider_raw_message_bodies", "consent_or_legal_basis", "campaign_policy", "global_suppression", "raw_send_transport"], "ad_intelligence": "stable_subject_ref_only", "prospect_records_in_ad_evidence": false, "prospect_records_in_public_exports": false, "pii_policy": "provider_owns_raw_bodies;_mail_keeps_minimized_provider_neutral_projections"},
  "trace": {"schema": "schema://frank.tool-app-trace/v1", "instrumentation": "opentelemetry", "span_prefix": "frank.mail", "attributes": ["mail.thread_id", "mail.message_id", "mail.connection_id", "mail.cursor_kind", "mail.delivery_state", "mail.reply_label"], "event_kinds": ["sync-started", "thread-upserted", "message-upserted", "receipt-recorded", "reply-recorded", "bounce-recorded", "complaint-recorded", "unsubscribe-recorded"]},
  "health": {"contract": "tool_health.v1", "checks": ["manifest_valid", "connection_capability_present", "cursor_store_reachable", "receipt_projection_available", "provider_raw_body_boundary_declared"], "states": ["healthy", "degraded", "unavailable"]},
  "hermes": {"contract": "hermes_tool_boundary.v1", "actions": ["sync", "thread-list", "thread-read", "receipt-read", "reply-classify", "compose-intent", "reply-intent"], "event_kinds": ["sync-started", "sync-completed", "thread-updated", "message-updated", "receipt-recorded", "reply-recorded", "bounce-recorded", "complaint-recorded", "unsubscribe-recorded", "reply-classified", "compose-intent-created", "reply-intent-created"], "forbidden_actions": ["raw-send", "provider-send", "delivery-request", "prospect-qualify"], "result_rule": "provider_neutral_projections_and_intents_only; provider owns raw bodies and delivery execution"}
}
