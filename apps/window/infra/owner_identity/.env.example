# Owner identity provider — example configuration.
#
# Store the real copy at /srv/frank/secrets/owner-identity.env with mode 0600,
# owned by root. It is deliberately outside Git and outside the runtime data
# directory. Only the wrapper bin/owner-identity reads it.
#
# Generate every empty value below with a fresh random secret, for example:
#   openssl rand -base64 48      # OWNER_IDENTITY_SECRET_KEY
#   openssl rand -hex 32         # OWNER_IDENTITY_DB_PASSWORD
#   openssl rand -hex 24         # OWNER_IDENTITY_BOOTSTRAP_PASSWORD
#   openssl rand -hex 32         # OWNER_IDENTITY_BOOTSTRAP_TOKEN
#   openssl rand -base64 24      # OWNER_IDENTITY_OWNER_PASSWORD
#
# Nothing in this file may be committed. It is listed in .gitignore as `.env`,
# and bin/owner-identity refuses a file that is not root-owned mode 0600.

# --- Pinned image -----------------------------------------------------------
# appswindow/infra/owner_identity/pins.env is the authority; these two values
# are repeated here because Compose interpolates the image reference before any
# script runs. bin/owner-identity config refuses any other pair.
OWNER_IDENTITY_TAG=2026.8.2
OWNER_IDENTITY_DIGEST=sha256:ff8489a5af4f4fe415ffd180a8e3c10b120bc2592d13d79dac050d977f7b9ecd

# --- Host identity ----------------------------------------------------------
# Public hostname of the identity provider. Must match the Caddy site block in
# apps/window/infra/owner_identity/caddy/owner_identity.caddy.
OWNER_IDENTITY_HOST=auth.frank.fail

# --- Secrets ----------------------------------------------------------------
# Django secret key for authentik. Rotating it invalidates every existing
# session and every encrypted value that authentik stores.
OWNER_IDENTITY_SECRET_KEY=
# Password for the `authentik` PostgreSQL role.
OWNER_IDENTITY_DB_PASSWORD=
# Applied only while the database is empty. OWNER_IDENTITY_BOOTSTRAP_TOKEN
# becomes the permanent API token of the built-in `akadmin` account and is what
# bin/bootstrap.py authenticates with, so it must stay set.
OWNER_IDENTITY_BOOTSTRAP_PASSWORD=
OWNER_IDENTITY_BOOTSTRAP_TOKEN=
# Initial password for the single owner identity. The owner is required to
# change it at first sign-in and to enrol a second factor.
OWNER_IDENTITY_OWNER_PASSWORD=

# --- Optional ---------------------------------------------------------------
OWNER_IDENTITY_LOG_LEVEL=info
# Age of a session that has not completed an authentication flow yet.
OWNER_IDENTITY_UNAUTHENTICATED_AGE=minutes=30
# Pinned subnets. The ingress subnet is also the trusted-proxy boundary.
OWNER_IDENTITY_INGRESS_SUBNET=172.31.50.0/24
OWNER_IDENTITY_INTERNAL_SUBNET=172.31.51.0/24

# --- Native applications this identity provider federates with --------------
OWNER_FRANK_ORIGIN=https://frank.fail
OWNER_CRM_ORIGIN=https://crm.frank.fail
OWNER_MARKETING_ORIGIN=https://marketing.frank.fail
# Container and loopback targets the native provisioning script talks to.
OWNER_CRM_CONTAINER=owner-crm-backend-1
OWNER_CRM_SITE=owner.crm.internal
OWNER_MARKETING_CONTAINER=frank-owner-marketing
