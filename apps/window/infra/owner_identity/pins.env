# Inputs accepted for the owner identity provider.
#
# Every value below is a digest-pinned container image or a pinned upstream
# release. `bin/owner-identity config` verifies the Compose file resolves to
# exactly these values before any container starts.
#
# No secrets here. The runtime secret file is /srv/frank/secrets/owner-identity.env.

# authentik server and worker. One image, two commands.
# MIT licensed; only the authentik/enterprise/ directory carries a separate
# licence and no enterprise feature is used by this deployment.
OWNER_IDENTITY_TAG=2026.8.2
OWNER_IDENTITY_DIGEST=sha256:ff8489a5af4f4fe415ffd180a8e3c10b120bc2592d13d79dac050d977f7b9ecd

# authentik supports PostgreSQL 14-18.
OWNER_IDENTITY_POSTGRES_IMAGE=postgres:16-alpine@sha256:cf78e76683b9ca8c5733cbbdce6c9262b45b6767934dd0a95e671f9a0fc20685

# Cache, task locks and the outpost session store.
OWNER_IDENTITY_REDIS_IMAGE=redis:7.4-alpine@sha256:ff02b58f971e7d7d156a1267e283fcbbeee91773b6aa36c49dac28ecfe28eadf

# Native applications this identity provider is wired to. Recorded so a
# reviewer can see the accepted upstream revisions the mapping was tested on.
OWNER_IDENTITY_FRAPPE_REF=v15.120.1
OWNER_IDENTITY_FRAPPE_SHA=9f8ae9cd25b6735be345da6cc12e9f5a96050c68
OWNER_IDENTITY_MAUTIC_REF=7.2.0
