[Unit]
Description=Frank bounded golden evaluation
[Service]
Type=oneshot
User=frank
WorkingDirectory=/projects/frank
ExecStart=/usr/bin/python3 /projects/frank/apps/window/scripts/run_scheduled_control_job.py evaluation
TimeoutStartSec=30m
NoNewPrivileges=true
ProtectSystem=strict
ReadOnlyPaths=/projects/frank
ReadWritePaths=/srv/frank/data/window/control-graph/schedules
