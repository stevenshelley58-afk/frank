[Unit]
Description=Frank quarterly isolated retention restore drill (non-destructive)
[Service]
Type=oneshot
User=root
WorkingDirectory=/projects/frank
ExecStart=/usr/bin/python3 /projects/frank/apps/window/scripts/run_restore_drill.py
TimeoutStartSec=60m
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
CapabilityBoundingSet=CAP_DAC_READ_SEARCH
ProtectSystem=strict
ReadOnlyPaths=/projects/frank /srv/frank/data/window
ReadWritePaths=/srv/frank/backups/control-plane
