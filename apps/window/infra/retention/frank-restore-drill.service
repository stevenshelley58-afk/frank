[Unit]
Description=Frank quarterly isolated retention restore drill (non-destructive)
[Service]
Type=oneshot
User=frank
WorkingDirectory=/projects/frank
ExecStart=/usr/bin/python3 /projects/frank/apps/window/scripts/run_scheduled_control_job.py retention --timeout 3600
TimeoutStartSec=60m
NoNewPrivileges=true
ProtectSystem=strict
ReadOnlyPaths=/projects/frank /srv/frank/data/window
ReadWritePaths=/srv/frank/data/window/control-graph/schedules
