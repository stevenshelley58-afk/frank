[Unit]
Description=Frank report-only cleanup candidates

[Service]
Type=oneshot
User=frank
ExecStart=/usr/bin/env python3 /srv/frank/apps/window/scripts/run_cleanup_report.py --weekly --output /srv/frank/data/window/control-graph/cleanup/weekly-frank.json
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/srv/frank/data/window/control-graph/cleanup
ReadOnlyPaths=/projects/frank
