{
  "$schema": "schema://frank.owner-crm-notifications/v1",
  "version": 1,
  "site": "owner.crm.internal",
  "endpoint": "http://127.0.0.1:18081",
  "topic": "owner-notifications",
  "webhooks": [
    {
      "name": "owner-crm-task-created-ntfy",
      "webhook_doctype": "CRM Task",
      "webhook_docevent": "after_insert",
      "condition": null,
      "enabled": 1,
      "request_url": "http://frank-owner-ntfy/",
      "request_method": "POST",
      "request_structure": "JSON",
      "enable_security": 0,
      "webhook_secret": null,
      "timeout": 5,
      "background_jobs_queue": "short",
      "webhook_json": "{\"topic\":\"owner-notifications\",\"title\":\"Owner CRM task created\",\"message\":\"A new owner CRM task requires review.\",\"tags\":[\"clipboard\"]}",
      "webhook_data": [],
      "webhook_headers": [
        {
          "key": "Authorization",
          "value": "publisher-basic"
        },
        {
          "key": "Content-Type",
          "value": "application/json"
        }
      ]
    },
    {
      "name": "owner-hd-ticket-created-ntfy",
      "webhook_doctype": "HD Ticket",
      "webhook_docevent": "after_insert",
      "condition": null,
      "enabled": 1,
      "request_url": "http://frank-owner-ntfy/",
      "request_method": "POST",
      "request_structure": "JSON",
      "enable_security": 0,
      "webhook_secret": null,
      "timeout": 5,
      "background_jobs_queue": "short",
      "webhook_json": "{\"topic\":\"owner-notifications\",\"title\":\"Owner support ticket created\",\"message\":\"A new owner support ticket requires review.\",\"tags\":[\"ticket\"]}",
      "webhook_data": [],
      "webhook_headers": [
        {
          "key": "Authorization",
          "value": "publisher-basic"
        },
        {
          "key": "Content-Type",
          "value": "application/json"
        }
      ]
    },
    {
      "name": "owner-crm-lead-created-ntfy",
      "webhook_doctype": "CRM Lead",
      "webhook_docevent": "after_insert",
      "condition": null,
      "enabled": 1,
      "request_url": "http://frank-owner-ntfy/",
      "request_method": "POST",
      "request_structure": "JSON",
      "enable_security": 0,
      "webhook_secret": null,
      "timeout": 5,
      "background_jobs_queue": "short",
      "webhook_json": "{\"topic\":\"owner-notifications\",\"title\":\"Owner CRM lead created\",\"message\":\"A new owner CRM lead requires review.\",\"tags\":[\"lead\"]}",
      "webhook_data": [],
      "webhook_headers": [
        {
          "key": "Authorization",
          "value": "publisher-basic"
        },
        {
          "key": "Content-Type",
          "value": "application/json"
        }
      ]
    },
    {
      "name": "owner-incoming-email-ntfy",
      "webhook_doctype": "Communication",
      "webhook_docevent": "after_insert",
      "condition": "doc.communication_medium == \"Email\" and doc.sent_or_received == \"Received\"",
      "enabled": 1,
      "request_url": "http://frank-owner-ntfy/",
      "request_method": "POST",
      "request_structure": "JSON",
      "enable_security": 0,
      "webhook_secret": null,
      "timeout": 5,
      "background_jobs_queue": "short",
      "webhook_json": "{\"topic\":\"owner-notifications\",\"title\":\"Owner inbound email received\",\"message\":\"A new inbound email requires review.\",\"tags\":[\"email\"]}",
      "webhook_data": [],
      "webhook_headers": [
        {
          "key": "Authorization",
          "value": "publisher-basic"
        },
        {
          "key": "Content-Type",
          "value": "application/json"
        }
      ]
    },
    {
      "name": "owner-incoming-email-reply-stop",
      "webhook_doctype": "Communication",
      "webhook_docevent": "after_insert",
      "condition": "doc.communication_medium == \"Email\" and doc.sent_or_received == \"Received\"",
      "enabled": 1,
      "request_url": "http://172.16.1.1:18085/api/owner-mail-events/reply",
      "request_method": "POST",
      "request_structure": "",
      "enable_security": 1,
      "webhook_secret": "owner-mail-reply-secret",
      "timeout": 30,
      "background_jobs_queue": "short",
      "webhook_json": null,
      "webhook_data": [
        {
          "key": "event_id",
          "fieldname": "name"
        },
        {
          "key": "sender",
          "fieldname": "sender"
        },
        {
          "key": "recipients",
          "fieldname": "recipients"
        },
        {
          "key": "cc",
          "fieldname": "cc"
        },
        {
          "key": "bcc",
          "fieldname": "bcc"
        },
        {
          "key": "communication_medium",
          "fieldname": "communication_medium"
        },
        {
          "key": "sent_or_received",
          "fieldname": "sent_or_received"
        },
        {
          "key": "in_reply_to",
          "fieldname": "in_reply_to"
        },
        {
          "key": "uid",
          "fieldname": "uid"
        },
        {
          "key": "email_account",
          "fieldname": "email_account"
        },
        {
          "key": "communication_date",
          "fieldname": "communication_date"
        },
        {
          "key": "message_id",
          "fieldname": "message_id"
        }
      ],
      "webhook_headers": [
        {
          "key": "Content-Type",
          "value": "application/json"
        }
      ]
    }
  ]
}
