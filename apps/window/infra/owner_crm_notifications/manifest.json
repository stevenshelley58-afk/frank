{
  "$schema": "schema://frank.owner-crm-notifications/v1",
  "version": 1,
  "site": "owner.crm.internal",
  "endpoint": "http://127.0.0.1:18081",
  "topic": "owner-notifications",
  "webhooks": [
    {
      "name": "owner-crm-task-created-ntfy",
      "webhook_doctype": "CRM Task",
      "webhook_docevent": "after_insert",
      "condition": null,
      "enabled": 1,
      "request_url": "http://frank-owner-ntfy/",
      "request_method": "POST",
      "request_structure": "JSON",
      "timeout": 5,
      "background_jobs_queue": "short",
      "webhook_json": "{\"topic\":\"owner-notifications\",\"title\":\"Owner CRM task created\",\"message\":\"A new owner CRM task requires review.\",\"tags\":[\"clipboard\"]}",
      "webhook_headers": [
        {
          "key": "Authorization",
          "value": "publisher-basic"
        },
        {
          "key": "Content-Type",
          "value": "application/json"
        }
      ]
    },
    {
      "name": "owner-hd-ticket-created-ntfy",
      "webhook_doctype": "HD Ticket",
      "webhook_docevent": "after_insert",
      "condition": null,
      "enabled": 1,
      "request_url": "http://frank-owner-ntfy/",
      "request_method": "POST",
      "request_structure": "JSON",
      "timeout": 5,
      "background_jobs_queue": "short",
      "webhook_json": "{\"topic\":\"owner-notifications\",\"title\":\"Owner support ticket created\",\"message\":\"A new owner support ticket requires review.\",\"tags\":[\"ticket\"]}",
      "webhook_headers": [
        {
          "key": "Authorization",
          "value": "publisher-basic"
        },
        {
          "key": "Content-Type",
          "value": "application/json"
        }
      ]
    },
    {
      "name": "owner-crm-lead-created-ntfy",
      "webhook_doctype": "CRM Lead",
      "webhook_docevent": "after_insert",
      "condition": null,
      "enabled": 1,
      "request_url": "http://frank-owner-ntfy/",
      "request_method": "POST",
      "request_structure": "JSON",
      "timeout": 5,
      "background_jobs_queue": "short",
      "webhook_json": "{\"topic\":\"owner-notifications\",\"title\":\"Owner CRM lead created\",\"message\":\"A new owner CRM lead requires review.\",\"tags\":[\"lead\"]}",
      "webhook_headers": [
        {
          "key": "Authorization",
          "value": "publisher-basic"
        },
        {
          "key": "Content-Type",
          "value": "application/json"
        }
      ]
    },
    {
      "name": "owner-incoming-email-ntfy",
      "webhook_doctype": "Communication",
      "webhook_docevent": "after_insert",
      "condition": "doc.communication_medium == \"Email\" and doc.sent_or_received == \"Received\"",
      "enabled": 1,
      "request_url": "http://frank-owner-ntfy/",
      "request_method": "POST",
      "request_structure": "JSON",
      "timeout": 5,
      "background_jobs_queue": "short",
      "webhook_json": "{\"topic\":\"owner-notifications\",\"title\":\"Owner inbound email received\",\"message\":\"A new inbound email requires review.\",\"tags\":[\"email\"]}",
      "webhook_headers": [
        {
          "key": "Authorization",
          "value": "publisher-basic"
        },
        {
          "key": "Content-Type",
          "value": "application/json"
        }
      ]
    }
  ]
}
