# Store the real copy at /srv/frank/secrets/owner-crm.env (mode 0600).
# It is deliberately outside Git and outside the runtime data directory.
OWNER_CRM_IMAGE=owner-crm-app
OWNER_CRM_TAG=frappe15.120.1-crm1.83.0-helpdesk1.30.1
OWNER_CRM_DB_PASSWORD=
OWNER_CRM_ADMIN_PASSWORD=

# Needed before encrypted backups can be enabled. This is a public age recipient;
# its recovery identity belongs off-host and must be restore-tested.
OWNER_CRM_BACKUP_RECIPIENT=
OWNER_CRM_BACKUP_ROOT=
