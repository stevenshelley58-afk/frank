#!/usr/bin/env bash
# The only supported operator entrypoint for this isolated foundation.
set -euo pipefail
script_dir=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
root_dir=$(cd "$script_dir/.." && pwd)
secret_file=/srv/frank/secrets/owner-crm.env
runtime_root=/srv/frank/owner-crm
frappe_uid=1000
frappe_gid=1000
mariadb_uid=999
mariadb_gid=999
redis_uid=999
redis_gid=1000

usage() { echo "usage: owner-crm {config|up|create-site|archive-failed-site|health|backup-preflight}" >&2; exit 2; }
fail() { echo "owner-crm: $*" >&2; exit 1; }
clean_source() {
  test -z "$(git -C "$root_dir" status --porcelain)" || fail "source checkout is not clean"
  git -C "$root_dir" rev-parse --verify HEAD^{commit} >/dev/null
}
secret_file_ok() {
  test -f "$secret_file" && test ! -L "$secret_file" || fail "secret file must be a regular file: $secret_file"
  test "$(stat -c %a "$secret_file")" = 600 || fail "secret file must be mode 0600"
  test "$(stat -c %u "$secret_file")" = 0 || fail "secret file must be root-owned"
}
value() { sed -n "s/^$1=//p" "$secret_file" | tail -n1; }
fixed_settings_ok() {
  test "$(value OWNER_CRM_IMAGE)" = owner-crm-app || fail "OWNER_CRM_IMAGE must be owner-crm-app"
  test "$(value OWNER_CRM_TAG)" = frappe15.120.1-crm1.83.0-helpdesk1.30.1 || fail "OWNER_CRM_TAG is not the accepted image tag"
}
prepare_runtime() {
  if test -e "$runtime_root" || test -L "$runtime_root"; then
    test -d "$runtime_root" && test ! -L "$runtime_root" || fail "runtime root is not a directory"
    test -f "$runtime_root/.owner-crm-runtime" && test ! -L "$runtime_root/.owner-crm-runtime" || fail "refusing an unmarked runtime root"
  else
    install -d -m 0711 -o root -g root "$runtime_root"
    install -m 0600 -o root -g root /dev/null "$runtime_root/.owner-crm-runtime"
  fi
  for d in sites logs; do
    test ! -L "$runtime_root/$d" || fail "runtime path is a symlink: $d"
    install -d -m 0700 -o "$frappe_uid" -g "$frappe_gid" "$runtime_root/$d"
  done
  test ! -L "$runtime_root/mariadb" || fail "runtime path is a symlink: mariadb"
  # MariaDB's official image runs its server as mysql (999:999). Its bind-mount
  # parent must be traversable by that user, including after a failed first run.
  install -d -m 0700 -o "$mariadb_uid" -g "$mariadb_gid" "$runtime_root/mariadb"
  test ! -L "$runtime_root/redis-queue" || fail "runtime path is a symlink: redis-queue"
  install -d -m 0700 -o "$redis_uid" -g "$redis_gid" "$runtime_root/redis-queue"
}

clean_source
secret_file_ok
fixed_settings_ok
export OWNER_CRM_SOURCE_SHA=$(git -C "$root_dir" rev-parse HEAD)
compose=(docker compose --project-directory "$root_dir" --env-file "$secret_file" -f "$root_dir/compose.yaml")
case ${1:-} in
  config) "${compose[@]}" config -q ;;
  up)
    prepare_runtime
    "${compose[@]}" up -d
    ;;
  create-site)
    prepare_runtime
    test ! -e "$runtime_root/sites/owner.crm.internal" || fail "site path already exists; refusing to overwrite a partial or existing site"
    # Recreate this owner-only one-shot service so a previous failed provision
    # cannot leave a stale common_site_config behind for the first site build.
    "${compose[@]}" up -d --force-recreate configurator
    "${compose[@]}" --profile tools run --rm create-site
    : > "$runtime_root/.owner-crm-site-created"
    chown root:root "$runtime_root/.owner-crm-site-created"
    chmod 0600 "$runtime_root/.owner-crm-site-created"
    "${compose[@]}" up -d
    "$script_dir/health.sh"
    ;;
  archive-failed-site)
    site_path="$runtime_root/sites/owner.crm.internal"
    test -d "$site_path" && test ! -L "$site_path" || fail "no regular failed site path to archive"
    test ! -e "$runtime_root/.owner-crm-site-created" || fail "owner CRM site is marked created; refusing to archive it"
    test -f "$site_path/site_config.json" && test ! -L "$site_path/site_config.json" || fail "failed site has no regular config"
    db_name=$(jq -r '.db_name // empty' "$site_path/site_config.json")
    [[ "$db_name" =~ ^_[a-z0-9]+$ ]] || fail "failed site config has an unexpected database name"
    db_password=$(value OWNER_CRM_DB_PASSWORD)
    test -n "$db_password" || fail "owner CRM database password is missing"
    databases=$("${compose[@]}" exec -T -e MYSQL_PWD="$db_password" db mariadb -uroot -N -e 'SHOW DATABASES') || fail "could not verify failed site database state"
    printf '%s\n' "$databases" | grep -Fxq "$db_name" && fail "failed site database exists; refusing to archive"
    archive_root="$runtime_root/failed-site-archives"
    install -d -m 0700 -o root -g root "$archive_root"
    archive_path="$archive_root/owner.crm.internal-$(date -u +%Y%m%dT%H%M%SZ)"
    mv "$site_path" "$archive_path"
    chown -R root:root "$archive_path"
    chmod -R go-rwx "$archive_path"
    echo "archived database-free failed owner site to $archive_path"
    ;;
  health) "$script_dir/health.sh" ;;
  backup-preflight) "$script_dir/backup-preflight.sh" ;;
  *) usage ;;
esac
