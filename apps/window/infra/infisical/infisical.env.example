# Copying this file is not a deployment step. deploy.sh creates the real file
# at /srv/infisical/secrets/infisical.env with fresh values and mode 0600.
INFISICAL_HOST_PORT=18082
POSTGRES_USER=infisical
POSTGRES_DB=infisical
POSTGRES_PASSWORD=GENERATED_AT_DEPLOY
REDIS_PASSWORD=GENERATED_AT_DEPLOY
ENCRYPTION_KEY=GENERATED_AT_DEPLOY
AUTH_SECRET=GENERATED_AT_DEPLOY
DB_CONNECTION_URI=postgres://infisical:GENERATED_AT_DEPLOY@db:5432/infisical
REDIS_URL=redis://:GENERATED_AT_DEPLOY@redis:6379
SITE_URL=http://127.0.0.1:18082
TELEMETRY_ENABLED=false
DISABLE_UPDATE_CHECK=true
