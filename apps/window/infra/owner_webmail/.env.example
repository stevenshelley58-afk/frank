# Real copy lives at /srv/frank/secrets/owner-webmail.env, mode 0600, root-owned.
# bin/provision-secret.sh creates it from the existing mailbox secret and the
# owner's address list. Never commit a value from this list.
#
# Stamped by the operator wrapper from the committed revision.
OWNER_WEBMAIL_SOURCE_SHA=

# Host loopback port the ingress binds. The identity layer proxies to the
# ingress container, not to this port.
OWNER_WEBMAIL_HOST_PORT=18107
OWNER_WEBMAIL_PUBLIC_URL=https://mail.frank.fail

# Mailbox transport. Purelymail: IMAP 993 implicit TLS, SMTP submission 465.
OWNER_WEBMAIL_IMAP_HOST=ssl://imap.purelymail.com:993
OWNER_WEBMAIL_IMAP_PLAIN_HOST=imap.purelymail.com
OWNER_WEBMAIL_SMTP_HOST=ssl://smtp.purelymail.com:465
OWNER_WEBMAIL_SMTP_PLAIN_HOST=smtp.purelymail.com
OWNER_WEBMAIL_IMAP_USER=
OWNER_WEBMAIL_IMAP_PASSWORD=

# The mailbox this deployment opens, and the sender aliases it may use.
OWNER_WEBMAIL_MAILBOX=
OWNER_WEBMAIL_IDENTITIES=
OWNER_WEBMAIL_DISPLAY_NAME=

# Roundcube encrypts the session-stored IMAP password with this key. It must be
# stable across restarts or every existing session is invalidated.
OWNER_WEBMAIL_DES_KEY=

# Launch session. INGRESS_SECRET proves a request came through the ingress;
# CONSUME_SECRET authorises the client's one-shot token redemption.
OWNER_WEBMAIL_INGRESS_SECRET=
OWNER_WEBMAIL_CONSUME_SECRET=
# Stable authenticated owner identity the identity layer passes on the launch
# route. "*" means "any identity the proxy authenticated", for the single-owner
# deployment; set the real value once the identity layer fixes one.
OWNER_WEBMAIL_OWNER_ID=*
OWNER_WEBMAIL_OWNER_HEADER=X-Frank-Owner
OWNER_WEBMAIL_TOKEN_TTL_SECONDS=120
# SameSite compares the registrable domain, so Lax already covers a framed
# panel under a sibling frank.fail subdomain. Raise to None only for a
# genuinely cross-site parent origin.
OWNER_WEBMAIL_COOKIE_SAMESITE=Lax

# Exactly which parent origin may frame the panel. The ingress sends this as a
# scoped CSP frame-ancestors, which is verified to override X-Frame-Options when
# both are present in Chromium. 'self' is added by the template and is required
# for the client's own internal frames.
OWNER_WEBMAIL_FRAME_ANCESTORS='https://frank.fail'
OWNER_WEBMAIL_MAX_UPLOAD=30m

# Host-header allowlist for the client. Comma-separated regexes.
OWNER_WEBMAIL_TRUSTED_HOSTS=^mail\.frank\.fail$
