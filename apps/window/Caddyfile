(frank_common_security_headers) {
    header {
        -Server
        -X-Powered-By
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "strict-origin-when-cross-origin"
        Cross-Origin-Opener-Policy "same-origin"
        Cross-Origin-Resource-Policy "same-origin"
        Permissions-Policy "accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(self), payment=(), usb=()"
    }
}

(frank_private_response_headers) {
    header {
        Content-Security-Policy "default-src 'self'; base-uri 'none'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self'; media-src 'self' blob:; worker-src 'self' blob:; manifest-src 'self'"
        Cache-Control "no-store, private"
        X-Robots-Tag "noindex, nofollow, noarchive, nosnippet"
    }
}

(frank_mini_api_response_headers) {
    header {
        Content-Security-Policy "default-src 'none'; base-uri 'none'; frame-ancestors 'none'"
        Cache-Control "no-store"
        X-Robots-Tag "noindex, nofollow, noarchive, nosnippet"
    }
}

(frank_mini_ui_response_headers) {
    header {
        Content-Security-Policy "default-src 'self'; base-uri 'none'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; script-src 'self'; style-src 'self'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self'; frame-src 'self' https://preview.frank.fail; manifest-src 'self'"
        # Revalidate the tiny Mini shell so a rebuilt conversation experience
        # cannot leave returning customers on an older cached script.
        Cache-Control "public, no-cache"
        X-Robots-Tag "index, follow"
    }
}

frank.fail {
    encode zstd gzip
    import frank_common_security_headers

    log {
        output stdout
        format filter {
            wrap json
            fields {
                request>headers>Authorization delete
                request>headers>Proxy-Authorization delete
                request>headers>X-Frank-Operator-Attestation delete
                request>headers>X-Mini-Claim delete
                request>headers>Cookie delete
                request>uri delete
                response>headers>Set-Cookie delete
            }
        }
    }

    route {
        @ad_template_release {
            method GET HEAD
            path_regexp ad_template_release ^/releases/ad-template-generator/[A-Za-z0-9][A-Za-z0-9._-]{0,127}/[A-Za-z0-9_-][A-Za-z0-9._/-]{0,511}\.(json|png|webp|jpg|jpeg|woff2?|ttf|otf)$
        }
        handle @ad_template_release {
            header {
                -Cache-Control
                Cache-Control "public, max-age=300"
                -Cross-Origin-Resource-Policy
                Cross-Origin-Resource-Policy "cross-origin"
                X-Robots-Tag "noindex, nofollow, noarchive, nosnippet"
            }
            reverse_proxy frank-window:8080 {
                header_up Host {host}
                header_up X-Real-IP {remote_host}
                header_up X-Forwarded-Proto https
                header_up -Authorization
                header_up -Proxy-Authorization
                header_up -Cookie
                header_up -X-Frank-Operator-Attestation
                header_down -Set-Cookie
            }
        }

        @pavone_root path /pavone
        handle @pavone_root {
            import frank_private_response_headers
            redir /pavone/ 308
        }

        @pavone path /pavone/*
        handle @pavone {
            import frank_private_response_headers
            request_body {
                max_size 14MB
            }
            reverse_proxy pavone-demo:8787 {
                header_up -Authorization
                header_up -Proxy-Authorization
                header_up -Cookie
                header_down -Set-Cookie
            }
        }

        # Frank is the public customer surface. Keep its handler ahead of the
        # operator-only fallback so the rest of Frank remains protected.
        @mini_api path /api/mini /api/mini/*
        handle @mini_api {
            import frank_mini_api_response_headers
            request_body {
                # Mini Frank accepts a small set of customer images and
                # documents. The application still enforces stricter
                # per-file, count, and media-type limits.
                max_size 56MB
            }
            reverse_proxy frank-window:8080 {
                header_up Host {host}
                header_up X-Real-IP {remote_host}
                header_up X-Forwarded-Proto https
                header_up -Authorization
                header_up -Proxy-Authorization
                header_up -Cookie
                header_up -X-Frank-Operator-Attestation
                header_down -Set-Cookie
            }
        }

        @frank_ui path /frank /frank/*
        handle @frank_ui {
            import frank_mini_ui_response_headers
            reverse_proxy frank-window:8080 {
                header_up Host {host}
                header_up X-Real-IP {remote_host}
                header_up X-Forwarded-Proto https
                header_up -Authorization
                header_up -Proxy-Authorization
                header_up -Cookie
                header_up -X-Frank-Operator-Attestation
                header_down -Set-Cookie
            }
        }

        # Preserve old customer links and asset references without leaving the
        # browser on the retired public path. Caddy keeps the original query.
        @mini_style path /mini/mini.css
        redir @mini_style /frank/style.css?{http.request.uri.query} 308
        @mini_app path /mini/mini.js
        redir @mini_app /frank/app.js?{http.request.uri.query} 308
        @mini_stream path /mini/mini_stream.mjs
        redir @mini_stream /frank/stream.mjs?{http.request.uri.query} 308
        @mini_api_module path /mini/mini_api.mjs
        redir @mini_api_module /frank/api.mjs?{http.request.uri.query} 308
        @mini_index path /mini/index.html
        redir @mini_index /frank/?{http.request.uri.query} 308
        @mini_legacy path /mini /mini/*
        redir @mini_legacy /frank/?{http.request.uri.query} 308

        handle {
            import frank_private_response_headers
            request_body {
                max_size 260MB
            }
            basic_auth {
                {$FRANK_BASIC_AUTH_USER} {$FRANK_BASIC_AUTH_HASH}
            }
            reverse_proxy frank-window:8080 {
                header_up Host {host}
                header_up X-Real-IP {remote_host}
                header_up X-Forwarded-Proto https
                header_up -Authorization
                header_up -X-Frank-Operator-Attestation
                header_up X-Frank-Operator-Attestation {$FRANK_BASIC_AUTH_HASH}
                flush_interval -1
            }
        }
    }
}

preview.frank.fail {
    header {
        -Server
        X-Content-Type-Options "nosniff"
        Referrer-Policy "no-referrer"
        Cross-Origin-Resource-Policy "cross-origin"
        # Published pages are passive, validated snapshots. No generated code
        # executes in the browser; navigation-capable markup is rejected before
        # publication and the response policy remains a second fail-closed wall.
        Content-Security-Policy "sandbox allow-same-origin allow-downloads; default-src 'self'; script-src 'none'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; media-src 'self' data:; connect-src 'none'; frame-src 'none'; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors https://frank.fail"
        Permissions-Policy "accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=()"
        Cache-Control "no-store"
        X-Robots-Tag "noindex, nofollow, noarchive, nosnippet"
    }
    route {
        # Frank publishes validated, regular, non-symlink snapshots here.
        # Hidden staging/backup paths are never customer-addressable.
        @mini_hidden path_regexp mini_hidden ^/mini/(?:[^/]+/)*\.
        respond @mini_hidden 404
        @mini_download path_regexp mini_download ^/mini/[^/]+/downloads/[A-Za-z0-9][A-Za-z0-9._-]{0,119}$
        handle @mini_download {
            header Content-Disposition "attachment"
            root * /srv/frank/previews
            try_files {path} =404
            file_server
        }
        handle {
            root * /srv/frank/previews
            try_files {path} {path}/index.html =404
            file_server
        }
    }
}

