{
	# Cloudflare terminates public TLS for the proxied zones (blockwise.sale and
	# any other zone switched to the orange cloud). These are Cloudflare's
	# published edge ranges, fetched from cloudflare.com/ips-v4 and /ips-v6.
	#
	# trusted_proxies makes {client_ip} resolve to the real customer instead of
	# the Cloudflare edge, and client_ip_headers tells Caddy that CF-Connecting-IP
	# is the authoritative client-IP header. CF-Connecting-IP is only honoured
	# when the connecting peer is inside trusted_proxies, so a direct-to-origin
	# request cannot spoof it.
	#
	# trusted_proxies_strict is deliberately NOT set: it selects the left-most
	# X-Forwarded-For entry, which the client controls. Default (right-most
	# untrusted) plus CF-Connecting-IP is the correct pairing here.
	servers {
		trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
		client_ip_headers CF-Connecting-IP
	}
}

(frank_common_security_headers) {
    header {
        -Server
        -X-Powered-By
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "strict-origin-when-cross-origin"
        Cross-Origin-Opener-Policy "same-origin-allow-popups"
        Cross-Origin-Resource-Policy "same-origin"
        Permissions-Policy "accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(self), payment=(), usb=()"
    }
}

(frank_private_response_headers) {
    header {
        X-Frame-Options "DENY"
        Content-Security-Policy "default-src 'self'; base-uri 'none'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self'; media-src 'self' blob:; worker-src 'self' blob:; manifest-src 'self'"
        Cache-Control "no-store, private"
        X-Robots-Tag "noindex, nofollow, noarchive, nosnippet"
    }
}

(frank_agenttrail_response_headers) {
