frank.fail {
    encode zstd gzip
    import frank_common_security_headers

    log {
        output stdout
        format filter {
            wrap json
            fields {
                request>headers>Authorization delete
                request>headers>Proxy-Authorization delete
                request>headers>X-Frank-Operator-Attestation delete
                request>headers>X-Mini-Claim delete
                request>headers>X-Mini-Account-Claim delete
                request>headers>Idempotency-Key delete
                request>headers>Referer delete
                # Cookie is intentionally NOT listed here: Caddy's log-filter field
                # deletion mutates the live request (caddyserver/caddy#5786 class bug
                # in 2.8.x), stripping the header from every request through this
                # edge instead of just redacting it in the log line. Cookie is
                # already redacted from logs by default (no log_credentials set).
                request>uri delete
                response>headers>Set-Cookie delete
            }
        }
    }

    route {
        # Claude MCP connector -> mcp-vps.service on the host, port 8787.
        # The MCP server validates the Authorization bearer token itself, so
        # this route must stay ahead of the operator Basic Auth fallback.
        # Host is rewritten because the MCP SDK transport security only
        # accepts 127.0.0.1:8787. Upstream is the docker gateway to the host.
        @claude_mcp path /mcpx /mcpx/*
        handle @claude_mcp {
            uri strip_prefix /mcpx
            reverse_proxy 172.30.0.128:8787 {
                header_up Host 127.0.0.1:8787
                header_up X-Forwarded-Proto https
                header_up X-Real-IP {remote_host}
            }
        }

        # Signed template packs and their hash-declared assets are intentionally
        # public, source-free release artifacts. Keep this exact read-only
        # route ahead of the operator-authenticated fallback.
        @ad_template_release {
            method GET HEAD
            path_regexp ad_template_release ^/releases/ad-template-generator/[A-Za-z0-9][A-Za-z0-9._-]{0,127}/[A-Za-z0-9_-][A-Za-z0-9._/-]{0,511}\.(json|png|webp|jpg|jpeg|woff2?|ttf|otf)$
        }
        handle @ad_template_release {
            header {
                -Cache-Control
                Cache-Control "public, max-age=31536000, immutable"
                -Cross-Origin-Resource-Policy
                Cross-Origin-Resource-Policy "cross-origin"
                X-Robots-Tag "noindex, nofollow, noarchive, nosnippet"
            }
            reverse_proxy frank-window:8080 {
                header_up Host {host}
                header_up X-Real-IP {remote_host}
                header_up X-Forwarded-Proto https
                header_up -Authorization
                header_up -Proxy-Authorization
                header_up -Cookie
                header_up -X-Frank-Operator-Attestation
                header_down -Set-Cookie
            }
        }

        @pavone_root path /pavone
        handle @pavone_root {
            import frank_private_response_headers
            redir /pavone/ 308
        }

        @pavone path /pavone/*
        handle @pavone {
            import frank_private_response_headers
            request_body {
                max_size 14MB
            }
            reverse_proxy pavone-demo:8787 {
                header_up -Authorization
                header_up -Proxy-Authorization
                header_up -Cookie
                header_down -Set-Cookie
            }
        }

        # Frank is the public customer surface. Keep its handler ahead of the
        # operator-only fallback so the rest of Frank remains protected.
        @mini_api path /api/mini /api/mini/*
        handle @mini_api {
            import frank_mini_api_response_headers
            request_body {
                # Mini Frank accepts a small set of customer images and
                # documents. The application still enforces stricter
                # per-file, count, and media-type limits.
                max_size 56MB
            }
            reverse_proxy frank-window:8080 {
                header_up Host {host}
                header_up X-Real-IP {remote_host}
                header_up X-Forwarded-Proto https
                header_up -Authorization
                header_up -Proxy-Authorization
                header_up -Cookie
                header_up -X-Frank-Operator-Attestation
                header_down -Set-Cookie
            }
        }

        # Generated artifacts are passive snapshots, but their delivery
        # authority differs. Owner and link routes contain bearer material and
        # must never be cached, indexed, or leaked in a same-origin Referer.
        # Published artifacts remain revalidated on every use so unpublishing
        # immediately withdraws the Window-backed projection.
        @mini_private_artifacts path /mini-frank/owner-artifacts/* /mini-frank/shared-artifacts/*
        handle @mini_private_artifacts {
            import frank_mini_private_artifact_response_headers
            reverse_proxy frank-window:8080 {
                header_up Host {host}
                header_up X-Real-IP {remote_host}
                header_up X-Forwarded-Proto https
                header_up -Authorization
                header_up -Proxy-Authorization
                header_up -Cookie
                header_up -X-Frank-Operator-Attestation
                header_down -Set-Cookie
            }
        }

        @mini_published_artifacts path /mini-frank/published-artifacts/*
        handle @mini_published_artifacts {
            import frank_mini_published_artifact_response_headers
            reverse_proxy frank-window:8080 {
                header_up Host {host}
                header_up X-Real-IP {remote_host}
                header_up X-Forwarded-Proto https
                header_up -Authorization
                header_up -Proxy-Authorization
                header_up -Cookie
                header_up -X-Frank-Operator-Attestation
                header_down -Set-Cookie
            }
        }

        # Mini Frank is one scoped product surface inside the canonical Frank
        # Window. Legacy /frank and /mini requests reach the same Window only
        # long enough to receive its path-preserving redirect.
        @mini_ui path /mini-frank /mini-frank/* /frank /frank/* /mini /mini/*
        handle @mini_ui {
            import frank_mini_ui_response_headers
            reverse_proxy frank-window:8080 {
                header_up Host {host}
                header_up X-Real-IP {remote_host}
                header_up X-Forwarded-Proto https
                header_up -Authorization
                header_up -Proxy-Authorization
                header_up -Cookie
                header_up -X-Frank-Operator-Attestation
                header_down -Set-Cookie
            }
        }

        # Live keeps the pinned AgentTrail board's native inline viewer and
        # read controls while remaining behind the operator Basic Auth edge.
        @agenttrail_mutation path /agenttrail/setup /agenttrail/setup/ /agenttrail/setup-board /agenttrail/setup-board/ /agenttrail/spawn /agenttrail/spawn/ /agenttrail/hook /agenttrail/hook/ /agenttrail/nudge /agenttrail/nudge/
        handle @agenttrail_mutation {
            respond "AgentTrail mutation routes are not available through Frank" 403
        }

        @agenttrail path /agenttrail /agenttrail/*
        handle @agenttrail {
            # Only the owner laptop on the private Tailscale network bypasses Basic Auth.
            @frank_operator_auth not remote_ip 100.86.154.37
            import frank_agenttrail_response_headers
            basic_auth @frank_operator_auth {
                {$FRANK_BASIC_AUTH_USER} {$FRANK_BASIC_AUTH_HASH}
                {$FRANK_ACCEPTANCE_AUTH_USER} {$FRANK_ACCEPTANCE_AUTH_HASH}
            }
            reverse_proxy frank-window:8080 {
                header_up Host {host}
                header_up X-Real-IP {remote_host}
                header_up X-Forwarded-Proto https
                header_up -Authorization
                header_up -Proxy-Authorization
                header_up -Cookie
                header_up -X-Frank-Operator-Attestation
                header_up X-Frank-Operator-Attestation {$FRANK_BASIC_AUTH_HASH}
                header_down -Set-Cookie
            }
        }

        @map_artifact path /api/control/maps/artifact /api/control/projections/*/artifact
        handle @map_artifact {
            @frank_operator_auth not remote_ip 100.86.154.37
            import frank_map_artifact_response_headers
            basic_auth @frank_operator_auth {
                {$FRANK_BASIC_AUTH_USER} {$FRANK_BASIC_AUTH_HASH}
                {$FRANK_ACCEPTANCE_AUTH_USER} {$FRANK_ACCEPTANCE_AUTH_HASH}
            }
            reverse_proxy frank-window:8080 {
                header_up Host {host}
                header_up X-Real-IP {remote_host}
                header_up X-Forwarded-Proto https
                header_up -Authorization
                header_up -X-Frank-Operator-Attestation
                header_up X-Frank-Operator-Attestation {$FRANK_BASIC_AUTH_HASH}
                header_down -Set-Cookie
            }
        }

        handle {
            import frank_private_response_headers
            @frank_operator_auth not remote_ip 100.86.154.37
            request_body {
                max_size 260MB
            }
            basic_auth @frank_operator_auth {
                {$FRANK_BASIC_AUTH_USER} {$FRANK_BASIC_AUTH_HASH}
                {$FRANK_ACCEPTANCE_AUTH_USER} {$FRANK_ACCEPTANCE_AUTH_HASH}
            }
            reverse_proxy frank-window:8080 {
                header_up Host {host}
                header_up X-Real-IP {remote_host}
                header_up X-Forwarded-Proto https
                header_up -Authorization
                header_up -X-Frank-Operator-Attestation
                header_up X-Frank-Operator-Attestation {$FRANK_BASIC_AUTH_HASH}
                flush_interval -1
            }
        }
    }
}

blockwise.sale {
    encode zstd gzip
    import frank_common_security_headers
    # The self-hosted Vue editor is embedded only by the Blockwise origin.
    # Keep every other product response unframeable.
    @blockwise_vue_editor path /vue-ad-editor /vue-ad-editor/*
    header @blockwise_vue_editor X-Frame-Options "SAMEORIGIN"
    @blockwise_not_vue_editor not path /vue-ad-editor /vue-ad-editor/*
    header @blockwise_not_vue_editor X-Frame-Options "DENY"

    log {
        output stdout
        format filter {
            wrap json
            fields {
                request>headers>Authorization delete
                request>headers>Proxy-Authorization delete
                # Cookie is intentionally NOT listed here: Caddy's log-filter field
                # deletion mutates the live request (caddyserver/caddy#5786 class bug
                # in 2.8.x), stripping the header from every blockwise request
                # instead of just redacting it in the log line. This broke PKCE email
                # confirmation, since the code_verifier cookie never reached the app.
                # Cookie is already redacted from logs by default (no log_credentials
                # set). Fixed 2026-09-06.
                request>uri delete
                response>headers>Set-Cookie delete
            }
        }
    }

    request_body {
        # Product Storage rejects files above 10 MiB. Leave bounded room for
        # multipart framing while keeping the shared edge fail-closed.
        max_size 14MB
    }

    # TLS terminates once at Frank's public edge. The product Caddy owns only
    # path routing on the isolated blockwise-product network.
    reverse_proxy product-caddy:80 {
        header_up Host {host}
        # {client_ip}, not {remote_host}: behind Cloudflare the latter is an edge
        # address. {client_ip} resolves the real customer from CF-Connecting-IP
        # using the trusted_proxies ranges set in the global block above.
        header_up X-Real-IP {client_ip}
        # Caddy's default puts THIS hop's address in X-Forwarded-For and drops
        # the original, which leaves product-caddy unable to recover the
        # customer address. Forward the resolved customer instead.
        header_up X-Forwarded-For {client_ip}
        header_up X-Forwarded-Proto https
    }
}

# mail.blockwise.sale is a deliberately tiny public Mautic boundary. Recipient
# unsubscribe and do-not-contact links are the only public paths; the Mautic
# admin, API, tracking, webviews, and every other path remain unreachable here.
mail.blockwise.sale {
    encode zstd gzip
    import frank_common_security_headers
    header {
        X-Frame-Options "DENY"
        Content-Security-Policy "default-src 'self'; base-uri 'none'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
        X-Robots-Tag "noindex, nofollow, noarchive, nosnippet"
        Cache-Control "no-store"
    }

    @mautic_optout {
        method GET POST
        path /email/unsubscribe/* /email/dnc/*
    }
    handle @mautic_optout {
        reverse_proxy frank-owner-marketing-ingress:80 {
            header_up Host {host}
            header_up X-Forwarded-Proto https
            header_up X-Real-IP {client_ip}
            header_up X-Forwarded-For {client_ip}
            header_up -Authorization
        }
    }
    handle {
        respond 404
    }
}

preview.frank.fail {
    header {
        -Server
        X-Content-Type-Options "nosniff"
        Referrer-Policy "no-referrer"
        Cross-Origin-Resource-Policy "cross-origin"
        # Published pages are passive, validated snapshots. No generated code
        # executes in the browser; navigation-capable markup is rejected before
        # publication and the response policy remains a second fail-closed wall.
        Content-Security-Policy "sandbox allow-same-origin allow-downloads; default-src 'self'; script-src 'none'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; media-src 'self' data:; connect-src 'none'; frame-src 'none'; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors https://frank.fail"
        Permissions-Policy "accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=()"
        Cache-Control "no-store"
        X-Robots-Tag "noindex, nofollow, noarchive, nosnippet"
    }
    route {
        # Mini artifacts are no longer anonymously addressable by job id.
        # Window now rechecks owner, active-share, or published authority for
        # every artifact request before reading this private projection.
        @mini_disabled path /mini /mini/*
        respond @mini_disabled 404

        # Frank publishes validated, regular, non-symlink snapshots here.
        # Hidden staging/backup paths are never customer-addressable.
        @mini_hidden path_regexp mini_hidden ^/mini/(?:[^/]+/)*\.
        respond @mini_hidden 404
        @mini_download path_regexp mini_download ^/mini/[^/]+/downloads/[A-Za-z0-9][A-Za-z0-9._-]{0,119}$
        handle @mini_download {
            header Content-Disposition "attachment"
            root * /srv/frank/previews
            try_files {path} =404
            file_server
        }
        handle {
            root * /srv/frank/previews
            try_files {path} {path}/index.html =404
            file_server
        }
    }
}

