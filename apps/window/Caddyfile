        X-Frame-Options "SAMEORIGIN"
        Content-Security-Policy "default-src 'self'; base-uri 'none'; object-src 'none'; frame-ancestors 'self'; form-action 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self'; media-src 'self' blob:; worker-src 'self' blob:"
        Cache-Control "no-store, private"
        X-Robots-Tag "noindex, nofollow, noarchive, nosnippet"
    }
}

(frank_map_artifact_response_headers) {
