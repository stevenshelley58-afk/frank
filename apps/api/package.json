{
  "name": "@frank/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "The FRANK Domain API. Fastify, versioned REST/JSON, OpenAPI 3.1 generated from the route schemas. ADR-006, ADR-017, FRANK-§12, FRANK-§16.2.",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "echo 'lint: api (schema + dependency gates run at repo root)'"
  },
  "dependencies": {
    "@frank/adapter-harness-goose": "workspace:*",
    "@frank/adapter-postgres": "workspace:*",
    "@frank/contracts": "workspace:*",
    "@frank/identity": "workspace:*",
    "@frank/policy": "workspace:*",
    "drizzle-orm": "0.45.2",
    "fastify": "5.10.0",
    "tsx": "4.23.11",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "22.10.2",
    "typescript": "5.7.2",
    "vitest": "2.1.8"
  },
  "frank": {
    "layer": "app",
    "mayDependOn": [
      "@frank/contracts",
      "@frank/policy",
      "@frank/identity",
      "@frank/adapter-postgres",
      "@frank/adapter-harness-goose"
    ]
  }
}
