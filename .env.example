FRANK_ENV=production
FRANK_SYSTEM_NAME=Frank Hub
FRANK_DOMAIN=frank.fail
FRANK_DASHBOARD_URL=https://hub.frank.fail
FRANK_API_URL=https://api.frank.fail

WEB_PORT=3000
API_PORT=8080

POSTGRES_DB=frank
POSTGRES_USER=frank
POSTGRES_PASSWORD=change-this-on-vps
DATABASE_URL=postgres://frank:change-this-on-vps@postgres:5432/frank

REDIS_URL=redis://redis:6379

CORS_ORIGINS=https://hub.frank.fail,http://localhost:3000
VITE_API_BASE_URL=/api

CLOUDFLARE_ACCESS_ENABLED=true
CLOUDFLARE_ACCESS_ISSUER=https://your-team-name.cloudflareaccess.com
CLOUDFLARE_ACCESS_AUDS=replace-with-hub-access-aud,replace-with-api-access-aud
# Backward-compatible single-AUD fallback. Prefer CLOUDFLARE_ACCESS_AUDS.
CLOUDFLARE_ACCESS_AUD=

OPENROUTER_API_KEY=

HERMES_ENABLED=false
HERMES_IMAGE=nousresearch/hermes-agent:latest
HERMES_API_BASE_URL=http://hermes:8642
HERMES_API_SERVER_KEY=
HERMES_TIMEOUT_SECONDS=1800
HERMES_STALL_TIMEOUT_SECONDS=300
HERMES_EVENTS_POLL_MS=1000
HERMES_WORKSPACE_ROOT=/opt/frank-hub/workspaces
HERMES_ARTIFACT_ROOT=/opt/frank-hub/runtime/artifacts
FRANK_BACKUP_ROOT=/opt/frank-backups

LOG_LEVEL=info
