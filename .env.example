HERMES_API_KEY=replace-with-hermes-session-key
FRANK_BASIC_AUTH_USER=replace-with-basic-auth-user
FRANK_BASIC_AUTH_HASH=replace-with-basic-auth-hash
HERMES_CONNECTIONS_AGENT_KEY=replace-with-dedicated-connections-agent-key
HERMES_VAULT_BROKER_URL=
HERMES_VAULT_BROKER_KEY=replace-with-dedicated-vault-broker-key
FRANK_CONNECTION_ALLOWED_ORIGINS=https://frank.fail
FRANK_VAULT_ALLOWED_ORIGINS=https://frank.fail
CONNECTIONS_STORE_FILE=/data/connections.json
CONNECTION_ACTIONS_FILE=/data/connection-actions.jsonl
CONNECTION_PLANS_FILE=/data/connection-plans.json
PROJECTS_STORE_FILE=/data/projects.json
VAULT_METADATA_FILE=/data/vault-metadata.json
# Provider-neutral readiness (Hermes owns verification; Frank never stores secrets).
MAUTIC_BASE_URL=
# MAUTIC_URL is a legacy alias; MAUTIC_BASE_URL wins when both are set.
MAUTIC_URL=
MAUTIC_CONNECTOR_STATUS=unconfigured
STALWART_BASE_URL=
STALWART_CONNECTOR_STATUS=unconfigured
CHATWOOT_BASE_URL=
CHATWOOT_CONNECTOR_STATUS=unconfigured
SUPPORT_CONVERSATIONS_FILE=/data/support-conversations.json
