FRANK_ENV=production
FRANK_SYSTEM_NAME=Frank Hub
FRANK_DOMAIN=frank.fail
FRANK_DASHBOARD_URL=https://hub.frank.fail
FRANK_API_URL=https://api.frank.fail

WEB_PORT=3000
API_PORT=8080

POSTGRES_DB=frank
POSTGRES_USER=frank
POSTGRES_PASSWORD=change-this-on-vps
DATABASE_URL=postgres://frank:change-this-on-vps@postgres:5432/frank

REDIS_URL=redis://redis:6379

CORS_ORIGINS=https://hub.frank.fail,http://localhost:3000
VITE_API_BASE_URL=/api

CLOUDFLARE_ACCESS_ENABLED=true
CLOUDFLARE_ACCESS_ISSUER=https://your-team-name.cloudflareaccess.com
CLOUDFLARE_ACCESS_AUDS=replace-with-hub-access-aud,replace-with-api-access-aud
# Backward-compatible single-AUD fallback. Prefer CLOUDFLARE_ACCESS_AUDS.
CLOUDFLARE_ACCESS_AUD=

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_CHAT_MODEL=gpt-5.2
OPENROUTER_API_KEY=

FRANK_HOST_AGENT_ENABLED=false
FRANK_HOST_AGENT_BASE_URL=http://host.docker.internal:8787
FRANK_HOST_AGENT_TOKEN=
FRANK_HOST_AGENT_TIMEOUT_SECONDS=30
FRANK_BROWSER_ENABLED=false
FRANK_BROWSER_IMAGE=jlesage/chromium:latest
FRANK_BROWSER_WIDTH=1600
FRANK_BROWSER_HEIGHT=1000
FRANK_BROWSER_APP_URL=https://chatgpt.com
FRANK_BROWSER_VNC_PASSWORD=

HERMES_ENABLED=false
HERMES_IMAGE=nousresearch/hermes-agent:latest
HERMES_API_BASE_URL=http://hermes:8642
HERMES_API_SERVER_KEY=
HERMES_TIMEOUT_SECONDS=1800
HERMES_STALL_TIMEOUT_SECONDS=300
HERMES_EVENTS_POLL_MS=1000
HERMES_WORKSPACE_ROOT=/opt/frank-hub/workspaces
HERMES_ARTIFACT_ROOT=/opt/frank-hub/runtime/artifacts
FRANK_BACKUP_ROOT=/opt/frank-backups

# Operator mode: lab allows broad VPS/dev work outside protected paths.
# Use guarded or production when you want write/host actions approval-gated.
FRANK_OPERATOR_MODE=lab
FRANK_REPO_WORKSPACE_PATH=/opt/frank-hub
FRANK_OPERATOR_ALLOWED_WORKSPACES=/opt/frank-hub,/opt/frank-hub/workspaces,/opt/frank-projects
FRANK_OPERATOR_PROTECTED_PATHS=/,/root,/etc,/boot,/var/lib/docker,/var/lib/postgresql,/opt/frank-backups,/opt/frank-hub/.env,/opt/frank-hub/runtime/access,/opt/frank-hub/runtime/hermes/.env,/opt/frank-hub/runtime/hermes/platforms/whatsapp/session
FRANK_ACCESS_ENV_FILE=./runtime/access/frank-access.env
FRANK_ACCESS_ENV_PATH=/opt/frank-hub/runtime/access/frank-access.env
FRANK_SECRET_WRITE_ENABLED=false
FRANK_SECRET_WRITE_ALLOWED_KEYS=FRANK_EMAIL_ADDRESS,FRANK_MOBILE_NUMBER,FRANK_WHATSAPP_NUMBER,FRANK_API_KEY_NAMES,FRANK_EMAIL_APP_PASSWORD,FRANK_WHATSAPP_API_TOKEN,OPENAI_API_KEY,OPENAI_CHAT_MODEL,OPENAI_BASE_URL,OPENROUTER_API_KEY,FRANK_HOST_AGENT_TOKEN,FRANK_BROWSER_VNC_PASSWORD,WHATSAPP_ENABLED,WHATSAPP_MODE,WHATSAPP_ALLOWED_USERS,WEBHOOK_ENABLED,WEBHOOK_SECRET,HERMES_WEBHOOK_SECRET
FRANK_LIMIT_EXTERNAL_SEND_PER_HOUR=25
FRANK_LIMIT_API_SPEND_USD_PER_DAY=10
FRANK_LIMIT_FILE_DELETE_MAX_COUNT=500
FRANK_LIMIT_HOST_COMMAND_TIMEOUT_SECONDS=1800
FRANK_DATABASE_DESTRUCTIVE_REQUIRES_LIMIT=true

# Prefer putting real values in runtime/access/frank-access.env on the VPS.
FRANK_EMAIL_ADDRESS=
FRANK_MOBILE_NUMBER=
FRANK_WHATSAPP_NUMBER=
FRANK_API_KEY_NAMES=OPENAI_API_KEY,OPENROUTER_API_KEY,FRANK_EMAIL_APP_PASSWORD,FRANK_WHATSAPP_API_TOKEN

# Hermes-native WhatsApp lab wiring. Put real values in runtime/access/frank-access.env.
WHATSAPP_ENABLED=false
WHATSAPP_MODE=bot
WHATSAPP_ALLOWED_USERS=
WEBHOOK_ENABLED=true
WEBHOOK_SECRET=
HERMES_WEBHOOK_BASE_URL=http://hermes:8644
HERMES_WEBHOOK_ROUTE=frank-whatsapp
HERMES_WEBHOOK_SECRET=

LOG_LEVEL=info
