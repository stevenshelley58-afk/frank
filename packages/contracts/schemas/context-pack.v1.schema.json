{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schema://frank.context-pack/v1",
  "title": "FRANK agent context pack",
  "description": "FRANK-§7.4. A signed manifest of what an agent was allowed to know for one assignment. It is the single boundary between FRANK's memory and a harness: an agent never inherits all of FRANK's knowledge merely because a tool could reach it. Minimized, hash-addressed, reproducible, signed. Recalled memory is carried in a distinct, generated-untrusted section.",
  "$defs": {
    "Sha256": { "type": "string", "pattern": "^(sha256:)?[0-9a-f]{64}$" },
    "RequirementRef": {
      "description": "FRANK-§0: every change traces to a requirement ID, a normative section locator, or an accepted ADR.",
      "type": "string",
      "pattern": "^([A-Z]+-[0-9]{3}|FRANK-§[0-9]+(\\.[0-9]+)*|ADR-[0-9]{3})$"
    },
    "ContextSource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "symbol": { "type": "string" },
        "lines": {
          "type": "object",
          "additionalProperties": false,
          "required": ["start", "end"],
          "properties": {
            "start": { "type": "integer", "minimum": 1 },
            "end": { "type": "integer", "minimum": 1 }
          }
        },
        "sha256": { "$ref": "#/$defs/Sha256" }
      }
    },
    "ToolGrant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["handle", "capability"],
      "properties": {
        "handle": {
          "description": "Opaque policy handle resolved by the broker at call time (FRANK-§7.1).",
          "type": "string",
          "pattern": "^tool://[A-Za-z0-9._-]+(/[A-Za-z0-9._-]+)*$"
        },
        "capability": { "type": "string", "minLength": 1 }
      }
    },
    "CredentialHandle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["handle", "classification"],
      "properties": {
        "handle": {
          "description": "Opaque secret handle; the secret never enters the pack.",
          "type": "string",
          "pattern": "^secret://[A-Za-z0-9._-]+(/[A-Za-z0-9._-]+)*$"
        },
        "classification": { "$ref": "schema://frank.classification/v1#/$defs/DataClass" }
      }
    },
    "AssignmentBudget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maxSpend", "currency", "deadline", "maxRetries"],
      "properties": {
        "maxSpend": { "type": "number", "minimum": 0 },
        "currency": { "type": "string", "pattern": "^[A-Z]{3}$" },
        "deadline": { "type": "string", "format": "date-time" },
        "maxRetries": { "type": "integer", "minimum": 0 }
      }
    },
    "RecalledMemory": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fact", "trust", "sourceId", "classification", "relevance"],
      "properties": {
        "fact": { "type": "string", "minLength": 1 },
        "trust": {
          "description": "Recalled memory is generated-untrusted (FRANK-§2.3): evidence to weigh, never a system instruction. The assembler must not stamp a higher trust on an ordinary recall.",
          "$ref": "schema://frank.classification/v1#/$defs/TrustLabel"
        },
        "sourceId": { "type": "string", "minLength": 1 },
        "classification": { "$ref": "schema://frank.classification/v1#/$defs/DataClass" },
        "relevance": { "type": "number", "minimum": 0, "maximum": 1 },
        "confirmedAt": { "type": "string", "format": "date-time" }
      }
    },
    "MemorySection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["recalled", "recallQuery", "backend"],
      "properties": {
        "recalled": {
          "description": "Minimized set, most relevant first. Empty (not omitted) means 'looked and minimized to nothing', distinct from 'forgot'.",
          "type": "array",
          "items": { "$ref": "#/$defs/RecalledMemory" }
        },
        "recallQuery": { "type": "string", "minLength": 1 },
        "backend": { "type": "string", "minLength": 1 }
      }
    },
    "EscalationPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["escalateWhen", "doNotAssume"],
      "properties": {
        "escalateWhen": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "doNotAssume": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      }
    },
    "ContextPackIntegrity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contentHash", "signerId", "signature", "signedAt"],
      "properties": {
        "contentHash": {
          "description": "SHA-256 over the canonicalized pack excluding this integrity block; makes the pack hash-addressed and reproducible.",
          "$ref": "#/$defs/Sha256"
        },
        "signerId": { "type": "string", "minLength": 1 },
        "signature": { "type": "string", "minLength": 1 },
        "signedAt": { "type": "string", "format": "date-time" }
      }
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "packId",
    "assignmentId",
    "cellId",
    "createdAt",
    "goal",
    "definitionOfDone",
    "requirements",
    "constraints",
    "allowedTools",
    "credentials",
    "classification",
    "egress",
    "budget",
    "expectedOutputs",
    "evidenceSchemaRef",
    "escalation",
    "memory",
    "integrity"
  ],
  "properties": {
    "schema": { "const": "frank.context-pack/v1" },
    "packId": { "type": "string", "minLength": 1 },
    "assignmentId": { "type": "string", "minLength": 1 },
    "cellId": { "type": "string", "minLength": 1 },
    "createdAt": { "type": "string", "format": "date-time" },
    "goal": { "type": "string", "minLength": 1 },
    "definitionOfDone": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "requirements": { "type": "array", "items": { "$ref": "#/$defs/RequirementRef" } },
    "adrExcerpts": { "type": "array", "items": { "type": "string" } },
    "sources": { "type": "array", "items": { "$ref": "#/$defs/ContextSource" } },
    "relatedWork": { "type": "array", "items": { "type": "string" } },
    "constraints": { "type": "array", "items": { "type": "string" } },
    "allowedTools": { "type": "array", "items": { "$ref": "#/$defs/ToolGrant" } },
    "credentials": { "type": "array", "items": { "$ref": "#/$defs/CredentialHandle" } },
    "classification": { "$ref": "schema://frank.classification/v1#/$defs/DataClass" },
    "egress": {
      "description": "FRANK-§7.4 'data classification and egress rule'.",
      "type": "string",
      "enum": ["none", "frank-internal-only", "approved-connectors", "public-web"]
    },
    "budget": { "$ref": "#/$defs/AssignmentBudget" },
    "expectedOutputs": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "evidenceSchemaRef": { "type": "string", "minLength": 1 },
    "escalation": { "$ref": "#/$defs/EscalationPolicy" },
    "memory": { "$ref": "#/$defs/MemorySection" },
    "integrity": { "$ref": "#/$defs/ContextPackIntegrity" }
  }
}
