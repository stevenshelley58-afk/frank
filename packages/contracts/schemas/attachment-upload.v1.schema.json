{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schema://frank.attachment-upload/v1",
  "oneOf": [
    { "$ref": "#/$defs/authorization_response" },
    { "$ref": "#/$defs/pending_status" },
    { "$ref": "#/$defs/materialized_status" }
  ],
  "$defs": {
    "reservation_state": { "enum": ["authorized", "uploading", "completed", "terminating", "cancelled", "expired", "rejected"] },
    "authorization_response": {
      "type": "object", "additionalProperties": false,
      "required": ["upload_id", "reservation_id", "tus_creation_url", "tus_headers", "tus_metadata", "capability_expires_at", "reservation_expires_at"],
      "properties": {
        "upload_id": { "type": "string", "minLength": 1 }, "reservation_id": { "type": "string", "format": "uuid" },
        "tus_creation_url": { "type": "string", "format": "uri" },
        "tus_headers": { "type": "object", "additionalProperties": false, "required": ["Authorization", "Tus-Resumable"], "properties": { "Authorization": { "type": "string", "pattern": "^Bearer .+$", "maxLength": 2055 }, "Tus-Resumable": { "const": "1.0.0" } } },
        "tus_metadata": { "type": "object", "additionalProperties": false, "required": ["upload_id", "reservation_id"], "properties": { "upload_id": { "type": "string", "minLength": 1 }, "reservation_id": { "type": "string", "format": "uuid" } } },
        "capability_expires_at": { "type": "string", "format": "date-time" }, "reservation_expires_at": { "type": "string", "format": "date-time" }
      }
    },
    "pending_status": {
      "type": "object", "additionalProperties": false, "required": ["upload_id", "reservation_state"],
      "properties": { "upload_id": { "type": "string", "minLength": 1 }, "reservation_state": { "$ref": "#/$defs/reservation_state" } }
    },
    "materialized_status": {
      "type": "object", "additionalProperties": false,
      "required": ["upload_id", "reservation_state", "attachment_id", "attachment_state", "scan_state", "extraction_state"],
      "properties": {
        "upload_id": { "type": "string", "minLength": 1 }, "reservation_state": { "$ref": "#/$defs/reservation_state" },
        "attachment_id": { "type": "string", "format": "uuid" }, "attachment_state": { "enum": ["staging", "scanning", "ready", "promoted", "rejected", "cancelled", "expired"] },
        "scan_state": { "enum": ["pending", "clean", "blocked", "failed"] }, "extraction_state": { "enum": ["none", "pending", "complete", "failed"] }
      }
    }
  }
}
