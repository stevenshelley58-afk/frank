{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schema://frank.chat-turn/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["conversation_id", "idempotency_key", "content", "attachment_ids"],
  "properties": {
    "conversation_id": { "type": "string", "minLength": 1 },
    "idempotency_key": { "type": "string", "minLength": 1, "maxLength": 255 },
    "content": { "type": "array", "minItems": 1, "maxItems": 10000, "items": { "oneOf": [
      { "type": "object", "additionalProperties": false, "required": ["type", "text"], "properties": { "type": { "const": "text" }, "text": { "type": "string", "minLength": 1, "maxLength": 1048576 } } },
      { "type": "object", "additionalProperties": false, "required": ["type", "attachment_id"], "properties": { "type": { "enum": ["image", "file"] }, "attachment_id": { "type": "string", "minLength": 1 } } }
    ] } },
    "attachment_ids": { "type": "array", "maxItems": 10000, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "route_profile": { "type": "string", "minLength": 1 },
    "requested_capability": { "enum": ["Auto", "Deep", "Vision", "Image"] },
    "requested_model_alias": { "type": "string", "minLength": 1 }
  }
}
