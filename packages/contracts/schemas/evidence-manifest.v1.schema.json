{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schema://frank.evidence/v1",
  "title": "FRANK artifact and evidence manifest",
  "description": "FRANK-§6.8, with required contents from §14.4. The evidence pack is what Steven reviews instead of an unbuilt proposal (§1.2 principle 3, ADR-014). A manifest is signed and its integrity hash covers every other field.",
  "$defs": {
    "Sha256": { "type": "string", "pattern": "^(sha256:)?[0-9a-f]{64}$" },
    "CheckResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "result", "required"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "result": {
          "description": "FRANK-§14.3 / BUILD-011: binary tests and deterministic tools outrank model opinion. A failing required check cannot be overridden by a favourable review.",
          "type": "string",
          "enum": ["pass", "fail", "skipped", "error"]
        },
        "required": {
          "description": "Explicit, never defaulted. JSON Schema `default` is an annotation that nothing fills in, so an omitted field would read as false and silently downgrade a blocking check to advisory — the exact failure BUILD-011 exists to prevent.",
          "type": "boolean"
        },
        "uri": { "type": "string" },
        "sha256": { "$ref": "#/$defs/Sha256" }
      }
    },
    "Review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reviewer", "kind", "modelFamily", "isolatedContextHash", "reportHash", "verdict"],
      "properties": {
        "reviewer": { "type": "string", "minLength": 1 },
        "kind": {
          "description": "FRANK-§14.3 adversarial review lattice.",
          "type": "string",
          "enum": ["correctness", "architecture", "security", "reliability", "product", "accessibility", "operations"]
        },
        "modelFamily": {
          "description": "BUILD-010: must differ from the implementing agent's family. 'different-from-builder' is asserted by the evidence service, not self-reported by the reviewer.",
          "type": "string",
          "minLength": 1
        },
        "isolatedContextHash": { "$ref": "#/$defs/Sha256" },
        "reportHash": { "$ref": "#/$defs/Sha256" },
        "verdict": { "type": "string", "enum": ["pass", "findings", "blocked"] },
        "findings": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["severity", "summary", "evidence"],
            "properties": {
              "severity": { "type": "string", "enum": ["critical", "high", "medium", "low", "note"] },
              "summary": { "type": "string", "minLength": 1 },
              "evidence": {
                "description": "FRANK-§14.3 noise control: a finding needs a reproducible path, a violated requirement, or concrete evidence. Style preferences are severity 'note' and do not block.",
                "type": "string",
                "minLength": 1
              },
              "file": { "type": "string" },
              "line": { "type": "integer", "minimum": 1 }
            }
          }
        }
      }
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "changeId",
    "createdAt",
    "retentionPolicy",
    "outcome",
    "requirements",
    "source",
    "execution",
    "artifacts",
    "checks",
    "reviews",
    "risks",
    "rollback",
    "cost",
    "integrity"
  ],
  "properties": {
    "schema": { "const": "frank.evidence/v1" },
    "changeId": { "type": "string", "minLength": 1 },
    "createdAt": { "type": "string", "format": "date-time" },
    "retentionPolicy": { "type": "string", "minLength": 1 },
    "outcome": {
      "description": "FRANK-§14.4 first item: plain-language outcome and user impact. Written for Steven, not for an operator.",
      "type": "object",
      "additionalProperties": false,
      "required": ["summary", "userImpact"],
      "properties": {
        "summary": { "type": "string", "minLength": 1 },
        "userImpact": { "type": "string", "minLength": 1 }
      }
    },
    "requirements": {
      "description": "FRANK-§0: every change traces to a requirement ID, a normative section locator, or an accepted ADR.",
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "pattern": "^([A-Z]+-[0-9]{3}|FRANK-§[0-9]+(\\.[0-9]+)*|ADR-[0-9]{3})$" }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "baseCommit", "headCommit", "lockfileSha256"],
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "baseCommit": { "type": "string", "minLength": 7 },
        "headCommit": { "type": "string", "minLength": 7 },
        "changedFiles": { "type": "array", "items": { "type": "string" } },
        "lockfileSha256": { "$ref": "#/$defs/Sha256" }
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["workflow", "policy", "environment", "agents"],
      "properties": {
        "workflow": { "type": "string", "minLength": 1 },
        "policy": { "type": "string", "minLength": 1 },
        "environment": {
          "description": "The pinned sandbox image digest the work actually ran in (FRANK-§15.4).",
          "type": "string",
          "minLength": 1
        },
        "agents": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "revision", "harness", "model"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "revision": { "type": "string", "minLength": 1 },
              "harness": { "type": "string", "minLength": 1 },
              "model": { "type": "string", "minLength": 1 },
              "skills": { "type": "array", "items": { "type": "string" } },
              "tools": { "type": "array", "items": { "type": "string" } }
            }
          }
        }
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "uri", "sha256"],
        "properties": {
          "kind": { "type": "string", "minLength": 1 },
          "uri": { "type": "string", "minLength": 1 },
          "sha256": { "$ref": "#/$defs/Sha256" }
        }
      }
    },
    "checks": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/CheckResult" } },
    "reviews": {
      "description": "FRANK-§14.3 requires a fresh-context review and a cross-model-family review (BUILD-009). Fewer than two entries cannot satisfy the release gate.",
      "type": "array",
      "minItems": 2,
      "items": { "$ref": "#/$defs/Review" }
    },
    "securityScan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tool", "result", "reportSha256"],
      "properties": {
        "tool": { "type": "string", "minLength": 1 },
        "result": { "type": "string", "enum": ["pass", "fail"] },
        "reportSha256": { "$ref": "#/$defs/Sha256" },
        "unresolvedCritical": { "type": "integer", "minimum": 0 },
        "unresolvedHigh": { "type": "integer", "minimum": 0 }
      }
    },
    "preview": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url", "artifactDigest", "expiresAt"],
      "properties": {
        "url": {
          "description": "FRANK-§16.3: previews live on a separately owned registrable domain, never a child of frank.fail.",
          "type": "string",
          "format": "uri"
        },
        "artifactDigest": { "$ref": "#/$defs/Sha256" },
        "expiresAt": { "type": "string", "format": "date-time" },
        "screenshots": {
          "description": "BUILD-007: desktop and mobile viewports are both required for user-facing changes.",
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["viewport", "uri", "sha256"],
            "properties": {
              "viewport": { "type": "string", "enum": ["desktop", "mobile"] },
              "uri": { "type": "string" },
              "sha256": { "$ref": "#/$defs/Sha256" }
            }
          }
        }
      }
    },
    "migration": {
      "description": "BUILD-008: database changes require forward migration, compatibility window, backup point, recovery procedure, and a restore test.",
      "type": "object",
      "additionalProperties": false,
      "required": ["forwardMigration", "compatibilityWindow", "backupPoint", "rehearsalResult"],
      "properties": {
        "forwardMigration": { "type": "string", "minLength": 1 },
        "compatibilityWindow": { "type": "string", "minLength": 1 },
        "backupPoint": { "type": "string", "minLength": 1 },
        "rehearsalResult": { "type": "string", "enum": ["pass", "fail"] }
      }
    },
    "risks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["summary", "severity", "residual"],
        "properties": {
          "summary": { "type": "string", "minLength": 1 },
          "severity": { "type": "string", "enum": ["critical", "high", "medium", "low"] },
          "residual": { "type": "boolean" }
        }
      }
    },
    "rollback": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "target", "runbookId"],
      "properties": {
        "kind": { "type": "string", "enum": ["release-pointer", "fix-forward", "compensating-action"] },
        "target": { "type": "string", "minLength": 1 },
        "runbookId": {
          "description": "FRANK-§26: evidence packs reference the runbook ID and version, not a free-text title.",
          "type": "string",
          "pattern": "^RB-[A-Z]+-[0-9]{3}@[0-9]+\\.[0-9]+\\.[0-9]+$"
        }
      }
    },
    "cost": {
      "description": "OPS-001 / §20 Cost: model, harness, time, and spend receipts reconciling to a run and project.",
      "type": "object",
      "additionalProperties": false,
      "required": ["currency", "totalSpend", "runId", "projectId"],
      "properties": {
        "currency": { "type": "string", "pattern": "^[A-Z]{3}$" },
        "totalSpend": { "type": "number", "minimum": 0 },
        "wallClockSeconds": { "type": "integer", "minimum": 0 },
        "runId": { "type": "string", "minLength": 1 },
        "projectId": { "type": "string", "minLength": 1 }
      }
    },
    "integrity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["manifestSha256", "signerId", "signature"],
      "properties": {
        "manifestSha256": { "$ref": "#/$defs/Sha256" },
        "signerId": { "type": "string", "minLength": 1 },
        "signature": { "type": "string", "minLength": 1 }
      }
    }
  }
}
