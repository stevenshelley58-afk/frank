{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schema://frank.policy-decision/v1",
  "title": "FRANK policy decision, action envelope, and standing authorization",
  "description": "FRANK-§6.9. Policy is evaluated at the action boundary, not inferred from the model's confidence. Models may propose envelopes but cannot sign, widen, or approve them. The Policy Service evaluates an immutable envelope; only then may the separate Execution Service exchange approved credential handles for short-lived credentials. Envelopes are single-use unless their declared idempotency semantics say otherwise.",
  "$defs": {
    "ActionClass": {
      "description": "FRANK-§6.9. Maps to the §7.6 default operating policy.",
      "type": "string",
      "enum": [
        "observe",
        "internal_reversible",
        "external_reversible",
        "financial_or_public",
        "destructive_or_privileged"
      ]
    },
    "ResourceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id"],
      "properties": {
        "kind": { "type": "string", "minLength": 1 },
        "id": { "type": "string", "minLength": 1 },
        "cellId": { "type": "string", "minLength": 1 }
      }
    },
    "ResourcePattern": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "idPattern"],
      "properties": {
        "kind": { "type": "string", "minLength": 1 },
        "idPattern": { "type": "string", "minLength": 1 }
      }
    },
    "NetworkScope": {
      "description": "FRANK-§15.6. Egress is allowlisted per action; 'any' is not representable.",
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "allowedHosts"],
      "properties": {
        "mode": { "type": "string", "enum": ["none", "allowlist", "proxied-allowlist"] },
        "allowedHosts": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      }
    },
    "ActionBudget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["currency", "maximumSpend", "maximumWallClockSeconds"],
      "properties": {
        "currency": { "type": "string", "pattern": "^[A-Z]{3}$" },
        "maximumSpend": { "type": "number", "minimum": 0 },
        "maximumWallClockSeconds": { "type": "integer", "minimum": 1 },
        "maximumTokens": { "type": "integer", "minimum": 0 }
      }
    },
    "ActionLimits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["budget", "networkScope", "maximumDataClass"],
      "properties": {
        "budget": { "$ref": "#/$defs/ActionBudget" },
        "networkScope": { "$ref": "#/$defs/NetworkScope" },
        "maximumDataClass": { "$ref": "schema://frank.classification/v1#/$defs/DataClass" },
        "retryLimit": { "type": "integer", "minimum": 0 }
      }
    },
    "CompensationPlan": {
      "description": "FRANK-§6.9 / BUILD-013. Required when the action's transaction mode is post-commit compensating recovery.",
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "procedure"],
      "properties": {
        "kind": { "type": "string", "enum": ["pre-commit-cancellable", "atomic-pointer", "post-commit-compensating"] },
        "procedure": { "type": "string", "minLength": 1 },
        "pointOfNoReturn": { "type": "string" }
      }
    },
    "PolicyDecision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "result",
        "policyVersion",
        "reasons",
        "evaluatedEnvelopeHash",
        "limits",
        "obligations"
      ],
      "properties": {
        "schema": {
          "description": "Discriminator. This $id carries three unrelated document types; without a const on every branch, consumers cannot narrow the union on one field and Ajv's oneOf error messages become unreadable.",
          "const": "frank.policy-decision/v1"
        },
        "result": {
          "type": "string",
          "enum": ["allow", "allow_with_limits", "hold_for_review", "deny"]
        },
        "policyVersion": { "type": "string", "minLength": 1 },
        "reasons": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "evaluatedEnvelopeHash": {
          "description": "Hash of the exact immutable envelope evaluated. A decision cannot be replayed against a different envelope.",
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "matchedAuthorizationId": { "type": "string" },
        "limits": { "$ref": "#/$defs/ActionLimits" },
        "expiresAt": { "type": "string", "format": "date-time" },
        "obligations": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      }
    },
    "ActionEnvelope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "actionId",
        "idempotencyKey",
        "nonce",
        "cellId",
        "principalId",
        "operation",
        "actionClass",
        "target",
        "requestHash",
        "dataClasses",
        "credentialHandles",
        "networkScope",
        "budget",
        "validFrom",
        "expiresAt",
        "signerId",
        "signature"
      ],
      "properties": {
        "schema": { "const": "frank.action/v1" },
        "actionId": { "type": "string", "minLength": 1 },
        "idempotencyKey": { "type": "string", "minLength": 1 },
        "nonce": {
          "description": "Single-use. Replay of a spent nonce is a mandatory conformance failure (FRANK-§6.9).",
          "type": "string",
          "minLength": 1
        },
        "cellId": { "type": "string", "minLength": 1 },
        "principalId": { "type": "string", "minLength": 1 },
        "delegatedActorId": { "type": "string" },
        "operation": { "type": "string", "minLength": 1 },
        "actionClass": { "$ref": "#/$defs/ActionClass" },
        "target": { "$ref": "#/$defs/ResourceRef" },
        "recipient": { "$ref": "#/$defs/ResourceRef" },
        "requestHash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "artifactDigest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "dataClasses": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "schema://frank.classification/v1#/$defs/DataClass" }
        },
        "credentialHandles": {
          "description": "FRANK-§2.3: opaque handles only. A raw token in this array is a contract violation, not a configuration mistake.",
          "type": "array",
          "items": { "type": "string", "pattern": "^handle:[A-Za-z0-9._:-]+$" }
        },
        "networkScope": { "$ref": "#/$defs/NetworkScope" },
        "budget": { "$ref": "#/$defs/ActionBudget" },
        "validFrom": { "type": "string", "format": "date-time" },
        "expiresAt": { "type": "string", "format": "date-time" },
        "compensation": { "$ref": "#/$defs/CompensationPlan" },
        "signerId": { "type": "string", "minLength": 1 },
        "signature": { "type": "string", "minLength": 1 }
      }
    },
    "StandingAuthorization": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "authorizationId",
        "ownerId",
        "allowedActors",
        "operations",
        "targetPattern",
        "maximumDataClass",
        "credentialScopes",
        "networkScope",
        "perActionBudget",
        "aggregateBudget",
        "evidenceObligations",
        "retryLimit",
        "validFrom",
        "expiresAt",
        "revocationCounter",
        "signerId",
        "signature"
      ],
      "properties": {
        "schema": { "const": "frank.authorization/v1" },
        "authorizationId": { "type": "string", "minLength": 1 },
        "ownerId": { "type": "string", "minLength": 1 },
        "allowedActors": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "operations": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "targetPattern": { "$ref": "#/$defs/ResourcePattern" },
        "recipientPattern": { "$ref": "#/$defs/ResourcePattern" },
        "maximumDataClass": { "$ref": "schema://frank.classification/v1#/$defs/DataClass" },
        "credentialScopes": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "networkScope": { "$ref": "#/$defs/NetworkScope" },
        "perActionBudget": { "$ref": "#/$defs/ActionBudget" },
        "aggregateBudget": { "$ref": "#/$defs/ActionBudget" },
        "evidenceObligations": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "retryLimit": { "type": "integer", "minimum": 0 },
        "validFrom": { "type": "string", "format": "date-time" },
        "expiresAt": {
          "description": "No standing authorization is perpetual. FRANK-§7.6 holds anything uncovered.",
          "type": "string",
          "format": "date-time"
        },
        "revocationCounter": { "type": "integer", "minimum": 0 },
        "signerId": { "type": "string", "minLength": 1 },
        "signature": { "type": "string", "minLength": 1 }
      }
    }
  },
  "oneOf": [
    { "$ref": "#/$defs/PolicyDecision" },
    { "$ref": "#/$defs/ActionEnvelope" },
    { "$ref": "#/$defs/StandingAuthorization" }
  ]
}
