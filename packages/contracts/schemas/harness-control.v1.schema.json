{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schema://frank.harness-control/v1",
  "anyOf": [
    { "$ref": "#/$defs/job_request" },
    { "$ref": "#/$defs/job_create_response" },
    { "$ref": "#/$defs/job_status_response" },
    { "$ref": "#/$defs/job_events_response" },
    { "$ref": "#/$defs/job_cancel_request" },
    { "$ref": "#/$defs/job_cancel_response" },
    { "$ref": "#/$defs/config" },
    { "$ref": "#/$defs/route" }
  ],
  "$defs": {
    "source_ref": {
      "type": "object", "additionalProperties": false, "required": ["kind", "id"],
      "properties": { "kind": { "type": "string", "minLength": 1 }, "id": { "type": "string", "minLength": 1 }, "version": { "type": "string", "minLength": 1 } }
    },
    "artifact": {
      "type": "object", "additionalProperties": false, "required": ["object_id", "source_ref"],
      "properties": { "object_id": { "type": "string", "minLength": 1 }, "source_ref": { "$ref": "#/$defs/source_ref" } }
    },
    "identifiers": { "type": "object", "additionalProperties": false, "required": ["cell_id", "actor_id", "request_id", "correlation_id", "trace_id", "policy_version"], "properties": { "cell_id": { "type": "string", "minLength": 1 }, "actor_id": { "type": "string", "minLength": 1 }, "request_id": { "type": "string", "minLength": 1 }, "correlation_id": { "type": "string", "minLength": 1 }, "trace_id": { "type": "string", "minLength": 1 }, "policy_version": { "type": "string", "minLength": 1 } } },
    "job_request": {
      "type": "object", "additionalProperties": false,
      "required": ["harness", "task_type", "idempotency_key", "scope", "input", "allowed_tools", "egress_profile"],
      "properties": {
        "harness": { "const": "hermes" }, "task_type": { "const": "browser-research" },
        "idempotency_key": { "type": "string", "minLength": 1, "maxLength": 255 },
        "scope": { "type": "object", "additionalProperties": false, "properties": { "project_id": { "type": "string", "minLength": 1, "maxLength": 200 }, "room_id": { "type": "string", "format": "uuid" } } },
        "input": { "type": "object", "additionalProperties": false, "required": ["query", "max_sources"], "properties": { "query": { "type": "string", "minLength": 1, "maxLength": 4096 }, "max_sources": { "type": "integer", "minimum": 1, "maximum": 50 }, "locale": { "type": "string", "minLength": 2, "maxLength": 35 } } },
        "allowed_tools": { "type": "array", "minItems": 1, "maxItems": 3, "uniqueItems": true, "items": { "enum": ["browser.search", "browser.open", "browser.extract"] } },
        "egress_profile": { "enum": ["research-public", "research-allowlist"] }
      }
    },
    "job_event": {
      "oneOf": [
        { "type": "object", "additionalProperties": false, "required": ["job_id", "cursor", "kind", "occurred_at", "payload"], "properties": { "job_id": { "type": "string", "format": "uuid" }, "cursor": { "type": "integer", "minimum": 0 }, "kind": { "const": "progress" }, "occurred_at": { "type": "string", "format": "date-time" }, "payload": { "type": "object", "additionalProperties": false, "required": ["summary"], "properties": { "summary": { "type": "string", "minLength": 1 } } } } },
        { "type": "object", "additionalProperties": false, "required": ["job_id", "cursor", "kind", "occurred_at", "payload"], "properties": { "job_id": { "type": "string", "format": "uuid" }, "cursor": { "type": "integer", "minimum": 0 }, "kind": { "const": "artifact" }, "occurred_at": { "type": "string", "format": "date-time" }, "payload": { "$ref": "#/$defs/artifact" } } },
        { "type": "object", "additionalProperties": false, "required": ["job_id", "cursor", "kind", "occurred_at", "payload"], "properties": { "job_id": { "type": "string", "format": "uuid" }, "cursor": { "type": "integer", "minimum": 0 }, "kind": { "const": "error" }, "occurred_at": { "type": "string", "format": "date-time" }, "payload": { "type": "object", "additionalProperties": false, "required": ["summary"], "properties": { "summary": { "type": "string", "minLength": 1 } } } } },
        { "type": "object", "additionalProperties": false, "required": ["job_id", "cursor", "kind", "occurred_at", "payload"], "properties": { "job_id": { "type": "string", "format": "uuid" }, "cursor": { "type": "integer", "minimum": 0 }, "kind": { "const": "terminal" }, "occurred_at": { "type": "string", "format": "date-time" }, "payload": { "type": "object", "additionalProperties": false, "required": ["status"], "properties": { "status": { "enum": ["completed", "failed", "cancelled"] }, "summary": { "type": "string", "minLength": 1 } } } } }
      ]
    },
    "job_create_response": { "$ref": "#/$defs/job_mutation_response" },
    "job_cancel_response": { "$ref": "#/$defs/job_mutation_response" },
    "job_mutation_response": {
      "type": "object", "additionalProperties": false,
      "required": ["job_id", "status", "created_at", "updated_at", "finished_at", "cancelled_at", "artifacts", "source_refs", "replayed", "identifiers"],
      "properties": {
        "job_id": { "type": "string", "format": "uuid" }, "status": { "$ref": "#/$defs/job_status" },
        "created_at": { "type": "string", "format": "date-time" }, "updated_at": { "type": "string", "format": "date-time" },
        "finished_at": { "type": ["string", "null"], "format": "date-time" }, "cancelled_at": { "type": ["string", "null"], "format": "date-time" },
        "artifacts": { "type": "array", "items": { "$ref": "#/$defs/artifact" } }, "source_refs": { "type": "array", "items": { "$ref": "#/$defs/source_ref" } }, "replayed": { "type": "boolean" }, "identifiers": { "$ref": "#/$defs/identifiers" }
      }
    },
    "job_status_response": {
      "type": "object", "additionalProperties": false,
      "required": ["job_id", "status", "created_at", "updated_at", "finished_at", "cancelled_at", "artifacts", "source_refs", "identifiers"],
      "properties": {
        "job_id": { "type": "string", "format": "uuid" }, "status": { "$ref": "#/$defs/job_status" },
        "created_at": { "type": "string", "format": "date-time" }, "updated_at": { "type": "string", "format": "date-time" },
        "finished_at": { "type": ["string", "null"], "format": "date-time" }, "cancelled_at": { "type": ["string", "null"], "format": "date-time" },
        "artifacts": { "type": "array", "items": { "$ref": "#/$defs/artifact" } }, "source_refs": { "type": "array", "items": { "$ref": "#/$defs/source_ref" } }, "identifiers": { "$ref": "#/$defs/identifiers" }
      }
    },
    "job_events_response": {
      "type": "object", "additionalProperties": false,
      "required": ["job_id", "status", "created_at", "updated_at", "finished_at", "cancelled_at", "artifacts", "source_refs", "events", "next_cursor", "identifiers"],
      "properties": {
        "job_id": { "type": "string", "format": "uuid" }, "status": { "$ref": "#/$defs/job_status" },
        "created_at": { "type": "string", "format": "date-time" }, "updated_at": { "type": "string", "format": "date-time" },
        "finished_at": { "type": ["string", "null"], "format": "date-time" }, "cancelled_at": { "type": ["string", "null"], "format": "date-time" },
        "artifacts": { "type": "array", "items": { "$ref": "#/$defs/artifact" } }, "source_refs": { "type": "array", "items": { "$ref": "#/$defs/source_ref" } },
        "events": { "type": "array", "items": { "$ref": "#/$defs/job_event" } }, "next_cursor": { "type": ["integer", "null"], "minimum": 0 }, "identifiers": { "$ref": "#/$defs/identifiers" }
      }
    },
    "job_cancel_request": {
      "type": "object", "additionalProperties": false, "required": ["idempotency_key"],
      "properties": { "idempotency_key": { "type": "string", "minLength": 1, "maxLength": 255 }, "reason": { "type": "string", "minLength": 1, "maxLength": 1024 } }
    },
    "job_status": { "enum": ["queued", "running", "completed", "failed", "cancelled"] },
    "config": { "type": "object", "additionalProperties": false, "required": ["id", "cell_id", "harness_id", "revision", "config", "status", "created_at", "created_by"], "properties": { "id": { "type": "string", "minLength": 1 }, "cell_id": { "type": "string", "minLength": 1 }, "harness_id": { "type": "string", "minLength": 1 }, "revision": { "type": "integer", "minimum": 1 }, "config": { "type": "object", "minProperties": 1 }, "status": { "enum": ["draft", "active", "superseded", "rolled_back"] }, "created_at": { "type": "string", "format": "date-time" }, "created_by": { "type": "string", "minLength": 1 }, "rollback_of": { "type": "string", "minLength": 1 } } },
    "route": { "type": "object", "additionalProperties": false, "required": ["id", "cell_id", "subject_kind", "subject_id", "revision", "profile", "aliases", "shadow_mode", "active", "created_at"], "properties": { "id": { "type": "string", "minLength": 1 }, "cell_id": { "type": "string", "minLength": 1 }, "subject_kind": { "enum": ["central", "project", "room"] }, "subject_id": { "type": "string", "minLength": 1 }, "room_id": { "type": "string", "format": "uuid" }, "revision": { "type": "integer", "minimum": 1 }, "profile": { "type": "string", "minLength": 1 }, "aliases": { "type": "object", "minProperties": 1, "additionalProperties": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } } }, "shadow_mode": { "type": "boolean" }, "active": { "type": "boolean" }, "created_at": { "type": "string", "format": "date-time" } } }
  }
}
