{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schema://frank.harness-control/v1",
  "oneOf": [{ "$ref": "#/$defs/job_request" }, { "$ref": "#/$defs/config" }, { "$ref": "#/$defs/route" }, { "$ref": "#/$defs/job_event" }, { "$ref": "#/$defs/job_cancel" }],
  "$defs": {
    "source_ref": { "type": "object", "additionalProperties": false, "required": ["kind", "id"], "properties": { "kind": { "type": "string", "minLength": 1 }, "id": { "type": "string", "minLength": 1 }, "version": { "type": "string", "minLength": 1 } } },
    "job_request": { "type": "object", "additionalProperties": false, "required": ["harness", "task_type", "idempotency_key", "scope", "input", "allowed_tools", "egress_profile"], "properties": {
      "harness": { "const": "hermes" }, "task_type": { "const": "browser-research" }, "idempotency_key": { "type": "string", "minLength": 1, "maxLength": 255 },
      "scope": { "type": "object", "additionalProperties": false, "properties": { "project_id": { "type": "string", "minLength": 1 }, "room_id": { "type": "string", "minLength": 1 } } },
      "input": { "type": "object", "additionalProperties": false, "required": ["query", "max_sources"], "properties": { "query": { "type": "string", "minLength": 1, "maxLength": 4096 }, "max_sources": { "type": "integer", "minimum": 1, "maximum": 50 }, "locale": { "type": "string", "minLength": 2, "maxLength": 35 } } },
      "allowed_tools": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["browser.search", "browser.open", "browser.extract"] } }, "egress_profile": { "enum": ["research-public", "research-allowlist"] }
    } },
    "config": { "type": "object", "additionalProperties": false, "required": ["id", "cell_id", "harness_id", "revision", "config", "status", "created_at", "created_by"], "properties": { "id": { "type": "string", "minLength": 1 }, "cell_id": { "type": "string", "minLength": 1 }, "harness_id": { "type": "string", "minLength": 1 }, "revision": { "type": "integer", "minimum": 1 }, "config": { "type": "object", "minProperties": 1 }, "status": { "enum": ["draft", "active", "superseded", "rolled_back"] }, "created_at": { "type": "string", "format": "date-time" }, "created_by": { "type": "string", "minLength": 1 }, "rollback_of": { "type": "string", "minLength": 1 } } },
    "route": { "type": "object", "additionalProperties": false, "required": ["id", "cell_id", "subject_kind", "subject_id", "revision", "profile", "aliases", "shadow_mode", "active", "created_at"], "properties": { "id": { "type": "string", "minLength": 1 }, "cell_id": { "type": "string", "minLength": 1 }, "subject_kind": { "enum": ["central", "project", "room"] }, "subject_id": { "type": "string", "minLength": 1 }, "room_id": { "type": "string", "minLength": 1 }, "revision": { "type": "integer", "minimum": 1 }, "profile": { "type": "string", "minLength": 1 }, "aliases": { "type": "object", "minProperties": 1, "additionalProperties": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } } }, "shadow_mode": { "type": "boolean" }, "active": { "type": "boolean" }, "created_at": { "type": "string", "format": "date-time" } } },
    "job_event": { "type": "object", "additionalProperties": false, "required": ["job_id", "cursor", "kind", "occurred_at"], "properties": { "job_id": { "type": "string", "minLength": 1 }, "cursor": { "type": "integer", "minimum": 0 }, "kind": { "enum": ["progress", "artifact", "error", "terminal"] }, "occurred_at": { "type": "string", "format": "date-time" }, "artifact": { "type": "object", "additionalProperties": false, "required": ["object_id", "source_ref"], "properties": { "object_id": { "type": "string", "minLength": 1 }, "source_ref": { "$ref": "#/$defs/source_ref" } } }, "summary": { "type": "string", "minLength": 1 } } },
    "job_cancel": { "type": "object", "additionalProperties": false, "required": ["job_id", "requested_by", "requested_at"], "properties": { "job_id": { "type": "string", "minLength": 1 }, "requested_by": { "type": "string", "minLength": 1 }, "reason": { "type": "string", "minLength": 1 }, "requested_at": { "type": "string", "format": "date-time" } } }
  }
}
