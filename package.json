{
  "name": "frank",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.11.0 <23"
  },
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "contracts:validate": "node tools/registry/validate-contracts.mjs",
    "registry:generate": "node tools/registry/generate-registry.mjs",
    "registry:check": "node tools/registry/generate-registry.mjs --check",
    "deps:check": "node tools/lint/dependency-direction.mjs",
    "env:validate": "node tools/lint/validate-environments.mjs",
    "verify": "pnpm run deps:check && pnpm run contracts:validate && pnpm run env:validate && pnpm run registry:check && turbo run typecheck lint test"
  },
  "devDependencies": {
    "@types/node": "22.10.2",
    "ajv": "8.17.1",
    "ajv-formats": "3.0.1",
    "turbo": "2.3.3",
    "typescript": "5.7.2",
    "vitest": "2.1.8",
    "yaml": "2.7.0"
  },
  "pnpm": {
    "overrides": {
      "vitest": "2.1.8"
    }
  }
}
