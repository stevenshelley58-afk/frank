{
  "name": "frank",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.11.0 <23"
  },
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "contracts:validate": "node tools/registry/validate-contracts.mjs",
    "registry:generate": "node tools/registry/generate-registry.mjs",
    "registry:check": "node tools/registry/generate-registry.mjs --check",
    "deps:check": "node tools/lint/dependency-direction.mjs",
    "env:validate": "node tools/lint/validate-environments.mjs",
    "verify": "pnpm run deps:check && pnpm run contracts:validate && pnpm run env:validate && pnpm run registry:check && turbo run typecheck lint test"
  },
  "devDependencies": {
    "@types/node": "22.10.2",
    "ajv": "8.17.1",
    "ajv-formats": "3.0.1",
    "turbo": "2.3.3",
    "typescript": "5.7.2",
    "vitest": "2.1.8",
    "yaml": "2.7.0"
  },
  "pnpm": {
    "overrides": {
      "vitest": "3.2.6",
      "vite": "6.4.3",
      "ws": "8.21.0",
      "sharp": "0.35.0",
      "postcss": "8.5.23",
      "nanoid": "3.3.17",
      "ajv": "8.18.0",
      "yaml": "2.8.3",
      "gaxios>uuid": "11.1.1",
      "googleapis-common>uuid": "11.1.1",
      "fast-json-stringify>fast-uri": "4.1.2",
      "@fastify/ajv-compiler>fast-uri": "3.1.5",
      "ajv>fast-uri": "3.1.5"
    }
  }
}
