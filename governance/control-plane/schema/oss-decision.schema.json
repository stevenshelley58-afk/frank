{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://frank.fail/schema/oss-decision/v1",
  "title": "Frank mandatory open-source decision receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id", "subject_id", "need", "must_have", "existing_local_solution", "search_queries",
    "search_evidence", "candidates", "decision", "selected_candidate",
    "custom_gap", "rollback_removal_path", "reviewed_at", "reviewer"
  ],
  "properties": {
    "id": {"type": "string", "pattern": "^receipt:oss-decision/[a-z0-9]+(?:-[a-z0-9]+)*(?:/[a-z0-9]+(?:-[a-z0-9]+)*)*$"},
    "subject_id": {"$ref": "#/$defs/stable_id"},
    "need": {"type": "string", "minLength": 1},
    "must_have": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "existing_local_solution": {"type": ["string", "null"]},
    "search_queries": {"type": "array", "minItems": 3, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "search_evidence": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "candidates": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/candidate"}},
    "decision": {"enum": ["reuse_existing", "adopt", "adapt", "compose", "reject", "custom_gap"]},
    "selected_candidate": {"type": ["string", "null"]},
    "custom_gap": {"oneOf": [{"$ref": "#/$defs/custom_gap"}, {"type": "null"}]},
    "rollback_removal_path": {"type": "string", "minLength": 1},
    "reviewed_at": {"type": "string", "format": "date"},
    "reviewer": {"type": "string", "minLength": 1},
    "rationale": {"type": "string", "minLength": 1},
    "status": {"type": "string", "pattern": "^[a-z0-9]+(?:_[a-z0-9]+)*$"},
    "security_evidence": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "security_unknowns": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "cost": {"type": "string", "minLength": 1}
  },
  "allOf": [
    {
      "if": {"properties": {"decision": {"const": "custom_gap"}}, "required": ["decision"]},
      "then": {
        "properties": {
          "selected_candidate": {"type": "null"},
          "custom_gap": {"$ref": "#/$defs/custom_gap"}
        }
      },
      "else": {
        "properties": {
          "selected_candidate": {"type": "string", "minLength": 1},
          "custom_gap": {"type": "null"}
        }
      }
    }
  ],
  "$defs": {
    "stable_id": {"type": "string", "pattern": "^(vps|project|repo|runtime|service|component|worker|store|route|capability|rule|skill|tool|plugin|cli|mcp|app|template|library|hook|gate|policy|runbook|eval|observer|source|release|projection|generation|receipt|proposal|finding|mapping|run|edge):[a-z0-9]+(?:-[a-z0-9]+)*(?:/[a-z0-9]+(?:-[a-z0-9]+)*)*$"},
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name", "source_url", "source_revision", "licence", "latest_release",
        "last_material_activity", "maintenance_evidence", "fit", "gaps",
        "runtime_cost", "integration_cost", "overlaps", "export_removal_path",
        "dependency_health_receipts"
      ],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "source_url": {"type": "string", "format": "uri"},
        "source_revision": {
          "type": "string",
          "pattern": "^(?:[0-9a-f]{40}|v?[0-9]+(?:\\.[0-9]+){1,3}(?:[-+][0-9A-Za-z.-]+)?|GitHub REST API version [0-9]{4}-[0-9]{2}-[0-9]{2})$"
        },
        "licence": {"type": "string", "minLength": 1},
        "latest_release": {"type": "string", "minLength": 1},
        "last_material_activity": {"type": "string", "minLength": 1},
        "maintenance_evidence": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "fit": {"type": "string", "minLength": 1},
        "gaps": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "runtime_cost": {"type": "string", "minLength": 1},
        "integration_cost": {"type": "string", "minLength": 1},
        "overlaps": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "export_removal_path": {"type": "string", "minLength": 1},
        "dependency_health_receipts": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
      }
    },
    "custom_gap": {
      "type": "object",
      "additionalProperties": false,
      "required": ["why_oss_does_not_cover_it", "owned_files", "estimated_surface"],
      "properties": {
        "why_oss_does_not_cover_it": {"type": "string", "minLength": 1},
        "owned_files": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "estimated_surface": {"type": "string", "minLength": 1}
      }
    }
  }
}
