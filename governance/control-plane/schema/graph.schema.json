{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://frank.fail/schema/control-graph/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "graph_revision", "nodes", "edges", "assertions"],
  "properties": {
    "schema_version": {"const": 1},
    "graph_revision": {"type": "string", "pattern": "^g_[0-9a-f]{64}$"},
    "nodes": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/node"}},
    "edges": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/edge"}},
    "assertions": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/assertion"}}
  },
  "$defs": {
    "stable_id": {"type": "string", "pattern": "^(vps|project|repo|runtime|service|component|worker|store|route|capability|rule|skill|tool|plugin|cli|mcp|app|template|library|hook|gate|policy|runbook|eval|observer|source|release|projection|generation|receipt|proposal|finding|mapping|run|edge):[a-z0-9]+(?:-[a-z0-9]+)*(?:/[a-z0-9]+(?:-[a-z0-9]+)*)*$"},
    "receipt_id": {"type": "string", "pattern": "^receipt:[a-z0-9]+(?:-[a-z0-9]+)*(?:/[a-z0-9]+(?:-[a-z0-9]+)*)*$"},
    "state_axes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lifecycle", "trust", "installation", "enablement", "production_authority"],
      "properties": {
        "lifecycle": {"enum": ["draft", "review", "approved", "deprecated", "retired"]},
        "trust": {"enum": ["unreviewed", "quarantined", "reviewed", "rejected"]},
        "installation": {"enum": ["not_installed", "installed"]},
        "enablement": {"enum": ["disabled", "enabled"]},
        "production_authority": {"enum": ["none", "read_only", "operate"]},
        "freshness": {"enum": ["fresh", "stale", "unavailable", "unknown"]},
        "health": {"enum": ["healthy", "degraded", "unhealthy", "unavailable", "unknown"]},
        "provider_status": {"enum": ["ready", "empty", "attention", "unavailable", "error"]},
        "reconciliation_result": {"enum": ["match", "missing_runtime", "undeclared_runtime", "revision_mismatch", "config_hash_mismatch", "route_mismatch", "unit_mismatch", "unparseable", "inaccessible", "stale"]},
        "confidence": {"enum": ["high", "medium", "low", "none"]}
      }
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "state_axes", "layer", "evidence_receipt_ids"],
      "properties": {
        "id": {"$ref": "#/$defs/stable_id"},
        "kind": {"enum": ["host", "edge", "route", "service", "container", "systemd_unit", "repo", "checkout", "project", "component", "capability", "rule", "skill", "tool", "plugin", "cli", "mcp", "app", "library", "template", "worker", "data_store", "volume", "artifact", "deployment", "release", "observer", "source", "evidence_receipt", "cleanup_finding", "change_proposal", "gate", "hook", "policy", "runbook", "observed-only/unclassified"]},
        "state_axes": {"$ref": "#/$defs/state_axes"},
        "layer": {"enum": ["declared", "observed"]},
        "evidence_receipt_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/receipt_id"}}
      }
    },
    "edge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "from", "to", "relationship", "evidence_receipt_ids"],
      "properties": {
        "id": {"type": "string", "pattern": "^edge:[a-z0-9]+(?:-[a-z0-9]+)*(?:/[a-z0-9]+(?:-[a-z0-9]+)*)*$"},
        "from": {"$ref": "#/$defs/stable_id"},
        "to": {"$ref": "#/$defs/stable_id"},
        "relationship": {"enum": ["contains", "owns", "runs", "exposes", "routes_to", "reads", "writes", "depends_on", "uses", "executes", "declares", "produces", "consumes", "validates", "deploys", "observes", "replaces"]},
        "evidence_receipt_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/receipt_id"}}
      }
    },
    "assertion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["subject_id", "predicate", "scope_id", "layer", "value", "evidence_receipt_ids"],
      "properties": {
        "subject_id": {"$ref": "#/$defs/stable_id"},
        "predicate": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
        "scope_id": {"$ref": "#/$defs/stable_id"},
        "layer": {"enum": ["declared", "observed", "evidence"]},
        "value": {"type": ["string", "number", "boolean", "null", "array", "object"]},
        "evidence_receipt_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/receipt_id"}}
      }
    }
  }
}
