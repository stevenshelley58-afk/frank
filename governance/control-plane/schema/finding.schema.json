{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://frank.fail/schema/control-finding/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "kind", "subject_ids", "severity", "status", "summary", "reconciliation_result", "confidence", "evidence_receipt_ids"],
  "properties": {
    "id": {"type": "string", "pattern": "^finding:[a-z0-9]+(?:-[a-z0-9]+)*(?:/[a-z0-9]+(?:-[a-z0-9]+)*)*$"},
    "kind": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
    "subject_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/stable_id"}},
    "severity": {"enum": ["low", "medium", "high", "critical"]},
    "status": {"enum": ["open", "accepted", "resolved", "dismissed", "candidate"]},
    "summary": {"type": "string", "minLength": 1, "maxLength": 500},
    "reconciliation_result": {"enum": ["match", "missing_runtime", "undeclared_runtime", "revision_mismatch", "config_hash_mismatch", "route_mismatch", "unit_mismatch", "unparseable", "inaccessible", "stale"]},
    "confidence": {"enum": ["high", "medium", "low", "none"]},
    "evidence_receipt_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/receipt_id"}}
  },
  "$defs": {
    "stable_id": {"type": "string", "pattern": "^(vps|project|repo|runtime|service|component|worker|store|route|capability|rule|skill|tool|plugin|cli|mcp|app|template|library|hook|gate|policy|runbook|eval|observer|source|release|projection|generation|receipt|proposal|finding|mapping|run|edge):[a-z0-9]+(?:-[a-z0-9]+)*(?:/[a-z0-9]+(?:-[a-z0-9]+)*)*$"},
    "receipt_id": {"type": "string", "pattern": "^receipt:[a-z0-9]+(?:-[a-z0-9]+)*(?:/[a-z0-9]+(?:-[a-z0-9]+)*)*$"}
  }
}
