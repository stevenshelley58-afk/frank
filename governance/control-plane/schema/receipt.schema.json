{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://frank.fail/schema/control-receipt/v1",
  "title": "Frank minimal immutable evidence receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "kind", "subject_ids", "producer", "source_revision_set", "deployed_revision_set", "captured_at", "fresh_until", "outcome", "evidence_uris", "redaction"],
  "properties": {
    "id": {"$ref": "#/$defs/receipt_id"},
    "kind": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
    "subject_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/stable_id"}},
    "producer": {"type": "string", "minLength": 1},
    "source_revision_set": {"type": "object", "additionalProperties": {"type": "string", "minLength": 1}},
    "deployed_revision_set": {"type": "object", "additionalProperties": {"type": "string", "minLength": 1}},
    "captured_at": {"type": "string", "format": "date-time"},
    "fresh_until": {"type": ["string", "null"], "format": "date-time"},
    "outcome": {"enum": ["pass", "fail", "partial"]},
    "evidence_uris": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "redaction": {"const": "secret_filtered"}
  },
  "$defs": {
    "stable_id": {"type": "string", "pattern": "^(vps|project|repo|runtime|service|component|worker|store|route|capability|rule|skill|tool|plugin|cli|mcp|app|template|library|hook|gate|policy|runbook|eval|observer|source|release|projection|generation|receipt|proposal|finding|mapping|run|edge):[a-z0-9]+(?:-[a-z0-9]+)*(?:/[a-z0-9]+(?:-[a-z0-9]+)*)*$"},
    "receipt_id": {"type": "string", "pattern": "^receipt:[a-z0-9]+(?:-[a-z0-9]+)*(?:/[a-z0-9]+(?:-[a-z0-9]+)*)*$"}
  }
}
