{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://frank.fail/schema/control-action/v1",
  "title": "Frank allowlisted managed action",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id", "enabled", "oss_decision_id", "adapter_id", "adapter_version",
    "adapter_hash", "allowed_target_kinds", "target_allowlist", "arguments",
    "authentication", "authority_level", "privilege_boundary",
    "executing_principal", "lock_key", "timeout_seconds", "cancellation",
    "idempotency", "preconditions", "expected_target_revision",
    "postconditions", "redaction_rules", "rollback_action_id",
    "confirmation_class"
  ],
  "properties": {
    "id": {"$ref": "#/$defs/action_id"},
    "enabled": {"type": "boolean"},
    "oss_decision_id": {"$ref": "#/$defs/receipt_id"},
    "adapter_id": {"$ref": "#/$defs/stable_id"},
    "adapter_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "adapter_hash": {"oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
    "allowed_target_kinds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"enum": ["vps", "project", "repo", "runtime", "service", "component", "worker", "store", "route", "capability", "rule", "skill", "tool", "plugin", "cli", "mcp", "app", "template", "library", "hook", "gate", "policy", "runbook", "eval", "observer", "source", "release", "projection", "generation", "receipt", "proposal", "finding", "mapping", "run", "edge"]}
    },
    "target_allowlist": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/stable_id"}
    },
    "arguments": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {"pattern": "^(?!(?:command|shell|script|code|executable)$)[a-z][a-z0-9_]*$"},
      "additionalProperties": {"$ref": "#/$defs/argument"},
      "required": ["idempotency_key"]
    },
    "authentication": {"enum": ["operator", "service", "hermes"]},
    "authority_level": {"enum": ["none", "read_only", "operate"]},
    "privilege_boundary": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*(?:/[a-z0-9]+(?:-[a-z0-9]+)*)*$"},
    "executing_principal": {"$ref": "#/$defs/stable_id"},
    "lock_key": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*(?:/[a-z0-9]+(?:-[a-z0-9]+)*)*$"},
    "timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 3600},
    "cancellation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["behavior"],
      "properties": {"behavior": {"enum": ["not_supported", "cooperative", "bounded", "terminal_idempotent"]}}
    },
    "idempotency": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "key_field", "replay_behavior"],
      "properties": {
        "required": {"const": true},
        "key_field": {"const": "idempotency_key"},
        "replay_behavior": {"const": "return_original_receipt"}
      }
    },
    "preconditions": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/check_name"}},
    "expected_target_revision": {"type": ["string", "null"], "minLength": 1},
    "postconditions": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/check_name"}},
    "redaction_rules": {"type": "array", "minItems": 1, "uniqueItems": true, "contains": {"const": "secret_filtered"}, "items": {"$ref": "#/$defs/check_name"}},
    "rollback_action_id": {"oneOf": [{"$ref": "#/$defs/action_id"}, {"type": "null"}]},
    "confirmation_class": {"enum": ["none", "operator", "destructive", "external"]}
  },
  "allOf": [
    {
      "if": {"properties": {"enabled": {"const": true}}, "required": ["enabled"]},
      "then": {"properties": {"adapter_hash": {"$ref": "#/$defs/sha256"}}}
    }
  ],
  "$defs": {
    "stable_id": {"type": "string", "pattern": "^(vps|project|repo|runtime|service|component|worker|store|route|capability|rule|skill|tool|plugin|cli|mcp|app|template|library|hook|gate|policy|runbook|eval|observer|source|release|projection|generation|receipt|proposal|finding|mapping|run|edge):[a-z0-9]+(?:-[a-z0-9]+)*(?:/[a-z0-9]+(?:-[a-z0-9]+)*)*$"},
    "action_id": {"type": "string", "pattern": "^tool:[a-z0-9]+(?:-[a-z0-9]+)*(?:/[a-z0-9]+(?:-[a-z0-9]+)*)*$"},
    "receipt_id": {"type": "string", "pattern": "^receipt:[a-z0-9]+(?:-[a-z0-9]+)*(?:/[a-z0-9]+(?:-[a-z0-9]+)*)*$"},
    "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "check_name": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
    "argument": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": {"enum": ["stable_id", "revision", "enum", "integer", "boolean", "idempotency_key"]},
        "values": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "minimum": {"type": "integer"},
        "maximum": {"type": "integer"}
      },
      "allOf": [
        {"if": {"properties": {"type": {"const": "enum"}}, "required": ["type"]}, "then": {"required": ["values"]}},
        {"if": {"properties": {"type": {"const": "idempotency_key"}}, "required": ["type"]}, "then": {"properties": {"values": false, "minimum": false, "maximum": false}}}
      ]
    }
  }
}
