# Candidate slots are immutable OCI references. Leave unset until the candidate verifier
# records its registry digest, signature and SBOM evidence. `latest` is prohibited.
# Current evidence starting points (2026-08-11): LiteLLM v1.96.0 with a hard security
# floor of v1.83.7, SeaweedFS 4.41, tusd v2.10.0, and ClamAV 1.5.4.
# These are tags, never image identities: every slot remains blank until its exact digest,
# generated digest-bound SBOM/source-license records and upstream OCI provenance are
# reviewed. Candidate evidence must not contain a hosted canary URL; that field is
# added only in a sealed-promotion manifest after the disposable hosted canary passes.
FRANK_LITELLM_CANDIDATE_IMAGE=
FRANK_SEAWEEDFS_CANDIDATE_IMAGE=
FRANK_TUSD_CANDIDATE_IMAGE=
FRANK_CLAMAV_CANDIDATE_IMAGE=

# Promotion copies candidate values to the separately protected current slot; rollback
# copies the previous current manifest to rollback. This file is never a deploy env file.
