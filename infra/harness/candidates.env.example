# Candidate slots are immutable OCI references. Leave unset until the candidate verifier
# records its registry digest, signature and SBOM evidence. `latest` is prohibited.
# LiteLLM 1.82.7 and 1.82.8 are expressly forbidden (2026 supply-chain incident).
FRANK_LITELLM_CANDIDATE_IMAGE=
FRANK_SEAWEEDFS_CANDIDATE_IMAGE=
FRANK_TUSD_CANDIDATE_IMAGE=
FRANK_CLAMAV_CANDIDATE_IMAGE=
FRANK_HERMES_CANDIDATE_IMAGE=
FRANK_LETTA_CANDIDATE_IMAGE=

# Promotion copies candidate values to the separately protected current slot; rollback
# copies the previous current manifest to rollback. This file is never a deploy env file.
