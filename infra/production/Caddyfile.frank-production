# Authoritative replacement for the existing `frank.fail { ... }` site block.
# Preserve the other live site blocks. Do not append this beside the old frank.fail
# block: Caddy must have one owner for the address.
#
# Required Caddy environment variable names (values are injected at runtime):
#   FRANK_BASIC_AUTH_USER
#   FRANK_BASIC_AUTH_HASH   (a Caddy-compatible bcrypt hash, never plaintext)

(frank_production_security_headers) {
    header {
        -Server
        -X-Powered-By
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "strict-origin-when-cross-origin"
        Cross-Origin-Opener-Policy "same-origin"
        Cross-Origin-Resource-Policy "same-origin"
        Permissions-Policy "accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=()"
        Content-Security-Policy "default-src 'self'; base-uri 'none'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' wss:; worker-src 'self' blob:; manifest-src 'self'"
        Cache-Control "no-store, private"
        X-Robots-Tag "noindex, nofollow, noarchive, nosnippet"
    }
}

(frank_production_basic_auth) {
    basic_auth {
        {$FRANK_BASIC_AUTH_USER} {$FRANK_BASIC_AUTH_HASH}
    }
}

(frank_production_api_proxy) {
    reverse_proxy {$FRANK_API_INTERNAL_URL} {
        header_up Host {host}
        header_up X-Real-IP {remote_host}
        header_up X-Forwarded-Proto https
        # Basic credentials terminate at Caddy and never enter application logs.
        header_up -Authorization
        flush_interval -1
    }
}

(frank_production_web_proxy) {
    reverse_proxy {$FRANK_WEB_INTERNAL_URL} {
        header_up Host {host}
        header_up X-Real-IP {remote_host}
        header_up X-Forwarded-Proto https
        # The authenticated browser reaches control routes through the web BFF.
        header_up -Authorization
        flush_interval -1
    }
}

frank.fail {
    encode zstd gzip
    import frank_production_security_headers

    # Access logs retain method, status, duration, host, and client metadata while
    # removing credentials, cookies, response cookies, and the complete URI/query.
    log {
        output stdout
        format filter {
            wrap json
            fields {
                request>headers>Authorization delete
                request>headers>Proxy-Authorization delete
                request>headers>Cookie delete
                request>uri delete
                response>headers>Set-Cookie delete
            }
        }
    }

    # Public machine health remains credential-free for external monitors.
    @frank_public_health path /v1/system/live /v1/system/ready
    route {
        # route preserves this literal order: the public health exception must be
        # evaluated before the authenticated /v1 catch-all.
        handle @frank_public_health {
            header Cache-Control "no-store"
            import frank_production_api_proxy
        }

        # Direct API/control requests and every application UI path require the coarse edge gate.
        # Application authorization remains mandatory behind it; Basic Auth is not a
        # replacement for FRANK sessions or capability checks.
        # Capability-bound resumable upload ingress only. tusd has no public route and
        # no download handler; the API issues and verifies the upload capability.
        @frank_tusd_upload path /v1/uploads/tus /v1/uploads/tus/ /v1/uploads/tus/*
        handle @frank_tusd_upload {
            import frank_production_basic_auth
            # 2 GiB is enforced again by tusd; this edge limit must not truncate a
            # resumable PATCH at the generic 8 MiB application-request limit.
            request_body { max_size 2147483648 }
            # Upload capability is distinct from Basic auth and hook credentials.
            # API gate verifies the persisted capability/reservation for every tus method.
            # It must fail closed and retain only Tus/capability headers. Browser Basic
            # Authorization is stripped; the tusd hook bearer is service-injected.
            forward_auth {$FRANK_UPLOAD_GATE_INTERNAL_URL} {
                # Caddy forward_auth always issues GET. The API gate contract is therefore
                # GET /private/tusd/gate and reads the original method/URI forwarded below.
                uri /private/tusd/gate
                header_up -x-frank-tusd-gate-secret
                header_up x-frank-tusd-gate-secret {$FRANK_TUSD_GATE_SECRET}
                header_up -Authorization
                # These are Caddy's documented forward_auth expanded-form fields:
                # the auth request is GET, while these preserve the original upload request.
                header_up X-Forwarded-Method {method}
                header_up X-Forwarded-Uri {uri}
                header_up X-Frank-Upload-Capability {http.request.header.X-Frank-Upload-Capability}
                header_up Upload-Metadata {http.request.header.Upload-Metadata}
                header_up Tus-Resumable {http.request.header.Tus-Resumable}
                header_up Upload-Offset {http.request.header.Upload-Offset}
            }
            reverse_proxy {$FRANK_TUSD_INTERNAL_URL} {
                # Basic auth ends at Caddy. tusd receives only the capability and its
                # injected hook credential, never a browser-supplied Authorization value.
                header_up -Authorization
                header_up Host {host}
                header_up X-Real-IP {remote_host}
                header_up X-Forwarded-Proto https
                header_up -X-Frank-Tusd-Hook-Secret
                header_up X-Frank-Tusd-Hook-Secret {$FRANK_TUSD_HOOK_SECRET}
                header_up X-Frank-Upload-Capability {http.request.header.X-Frank-Upload-Capability}
                header_up Upload-Metadata {http.request.header.Upload-Metadata}
                header_up Tus-Resumable {http.request.header.Tus-Resumable}
                header_up Upload-Offset {http.request.header.Upload-Offset}
                flush_interval -1
            }
        }

        handle /v1/* {
            import frank_production_basic_auth
            request_body { max_size 8MB }
            import frank_production_api_proxy
        }

        handle {
            import frank_production_basic_auth
            request_body { max_size 8MB }
            import frank_production_web_proxy
        }
    }
}
